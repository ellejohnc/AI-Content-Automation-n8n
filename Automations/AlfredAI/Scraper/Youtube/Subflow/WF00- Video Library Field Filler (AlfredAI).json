    {
      "parameters": {
        "url": "=https://www.googleapis.com/youtube/v3/videos?part=snippet,statistics,contentDetails&id={{ $input.all().map(i => i.json['Video ID']).join(',') }}&key=AIzaSyCiu4jOmy7kvNLMU9KAFcHhIW8ZVfB4OkQ",
        "options": {}
      },
      "id": "80c19a43-a0b5-44e3-8f2b-4bfc0f634129",
      "name": "4. Fetch YouTube Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        624,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const ytResponse = $input.all()[0].json;\nconst ytItems = ytResponse.items || [];\nconst batchRecords = $('3. Batch of 5').all();\n\nconst ytMap = {};\nfor (const yt of ytItems) ytMap[yt.id] = yt;\n\nconst results = [];\n\nfor (const record of batchRecords) {\n  const existing = record.json;\n  const videoId  = existing['Video ID'];\n  const yt       = ytMap[videoId];\n\n  const fieldsToUpdate = {};\n\n  if (yt) {\n    const dur = yt.contentDetails?.duration || 'PT0S';\n    let s = 0;\n    const m = dur.match(/PT(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+)S)?/);\n    if (m) s = (parseInt(m[1]||0)*3600)+(parseInt(m[2]||0)*60)+parseInt(m[3]||0);\n    const ct    = s <= 60 ? 'Short' : 'Video';\n    const ytUrl = ct === 'Short'\n      ? `https://www.youtube.com/shorts/${videoId}`\n      : `https://www.youtube.com/watch?v=${videoId}`;\n    const ytTags      = Array.isArray(yt.snippet?.tags) ? yt.snippet.tags.join(', ') : '';\n    const ytTitle     = yt.snippet?.title        || '';\n    const ytChannelId = yt.snippet?.channelId    || '';\n    const ytDesc      = yt.snippet?.description  || '';\n    const ytPublished = yt.snippet?.publishedAt  || '';\n    const ytViews     = parseInt(yt.statistics?.viewCount    || 0);\n    const ytLikes     = parseInt(yt.statistics?.likeCount    || 0);\n    const ytComments  = parseInt(yt.statistics?.commentCount || 0);\n\n    if (!existing['Title']        && ytTitle)      fieldsToUpdate['Title']        = ytTitle;\n    if (!existing['URL'])                           fieldsToUpdate['URL']          = ytUrl;\n    if (!existing['Channel ID']   && ytChannelId)  fieldsToUpdate['Channel ID']   = ytChannelId;\n    if (!existing['Description']  && ytDesc)       fieldsToUpdate['Description']  = ytDesc;\n    if (!existing['Tags']         && ytTags)       fieldsToUpdate['Tags']         = ytTags;\n    if (!existing['Published At'] && ytPublished)  fieldsToUpdate['Published At'] = ytPublished;\n    if (!existing['Duration'])                      fieldsToUpdate['Duration']     = s;\n    if (!existing['Content Type'])                  fieldsToUpdate['Content Type'] = ct;\n    if (!existing['Platform'])                      fieldsToUpdate['Platform']     = 'YouTube';\n\n    if (ytViews    !== (existing['View Count']    || 0)) fieldsToUpdate['View Count']    = ytViews;\n    if (ytLikes    !== (existing['Like Count']    || 0)) fieldsToUpdate['Like Count']    = ytLikes;\n    if (ytComments !== (existing['Comment Count'] || 0)) fieldsToUpdate['Comment Count'] = ytComments;\n  }\n\n  results.push({\n    json: {\n      airtable_record_id:      existing.id,\n      existing_channel_id:     existing['Channel ID'] || '',\n      existing_source_name:    existing['Source Name'] || '',\n      existing_assoc:          existing['Associated_Sources'] || [],\n      existing_creator_handle: existing['Creator_Handle'] || '',\n      existing_platform:       existing['Platform'] || 'YouTube',\n      fieldsToUpdate\n    }\n  });\n}\n\nreturn results;\n"
      },
      "id": "42a29cf5-2031-4e53-8120-53d81b89d129",
      "name": "5. Parse Missing Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        352
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "b5275ec1-5cc0-47a6-b598-0584db9da639",
      "name": "6. Wait 3s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1296,
        352
      ],
      "webhookId": "filler-wait"
    },
    {
      "parameters": {},
      "id": "b97d844a-2cb0-4b40-a7a6-74b310d40718",
      "name": "8. All Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        624,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const sourceRadarItems = $('2b. Get Source Radar').all();\n\n// Build lookup maps keyed by Channel ID and Source Name\n// Include all handle fields from Source Radar\nconst channelIdToSource   = {};\nconst channelNameToSource = {};\nfor (const src of sourceRadarItems) {\n  const chId    = src.json['YouTube Channel ID'] || '';\n  const srcName = src.json['Source Name'] || '';\n  const recId   = src.json.id;\n\n  // Get handle for each platform\n  const ytLinks  = src.json['YouTube_Links'] || '';\n  const igHandle = src.json['Instagram_Handle'] || '';\n  const ttHandle = src.json['TikTok_Handle'] || '';\n\n  // Extract @handle from YouTube_Links (e.g. youtube.com/@nicksaraev → @nicksaraev)\n  const ytHandleMatch = ytLinks.match(/(@[A-Za-z0-9_.-]+)/);\n  const ytHandle = ytHandleMatch ? ytHandleMatch[1] : '';\n\n  const srcObj = { id: recId, name: srcName, ytHandle, igHandle, ttHandle };\n  if (chId)    channelIdToSource[chId]                    = srcObj;\n  if (srcName) channelNameToSource[srcName.toLowerCase()] = srcObj;\n}\n\nconst videoItems = $('5. Parse Missing Fields').all();\nconst results = [];\n\nfor (const item of videoItems) {\n  const v = item.json;\n  const fieldsToUpdate = { ...v.fieldsToUpdate };\n\n  const channelId  = fieldsToUpdate['Channel ID'] || v.existing_channel_id || '';\n  const sourceName = v.existing_source_name || '';\n  const platform   = fieldsToUpdate['Platform'] || v.existing_platform || 'YouTube';\n\n  const match = channelIdToSource[channelId]\n    || channelNameToSource[sourceName.toLowerCase()]\n    || null;\n\n  // Source Name — fill if missing\n  if (!v.existing_source_name && match) {\n    fieldsToUpdate['Source Name'] = match.name;\n  }\n\n  // Associated_Sources — fill if missing\n  const hasAssoc = Array.isArray(v.existing_assoc) && v.existing_assoc.length > 0;\n  if (!hasAssoc && match) {\n    fieldsToUpdate['Associated_Sources'] = [match.id];\n  }\n\n  // Creator_Handle — fill if missing, pick correct handle by platform\n  if (!v.existing_creator_handle && match) {\n    let handle = '';\n    if (platform === 'Instagram') {\n      handle = match.igHandle;\n    } else if (platform === 'TikTok') {\n      handle = match.ttHandle;\n    } else {\n      // YouTube — use extracted @handle from YouTube_Links\n      handle = match.ytHandle;\n    }\n    if (handle) fieldsToUpdate['Creator_Handle'] = handle;\n  }\n\n  results.push({\n    json: {\n      id: v.airtable_record_id,\n      ...fieldsToUpdate\n    }\n  });\n}\n\nconst toUpdate = results.filter(r => Object.keys(r.json).length > 1).length;\nconsole.log(`Total: ${results.length} | Actually updating: ${toUpdate} | Passing through: ${results.length - toUpdate}`);\nreturn results;\n"
      },
