      "id": "26ff3dd0-858c-4c2a-92af-7ede20968d0d",
      "name": "1. Get Sources to Resolve",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        1904,
        -224
      ],
      "credentials": {
        "airtableOAuth2Api": {
          "id": "3nxfujQCXcfQc8IW",
          "name": "Airtable OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const rawUrl   = item.json['YouTube_Links'] || '';\n  const recordId = item.json.id;\n\n  if (!rawUrl) continue;\n\n  // Normalise: strip query string and trailing path segments\n  const cleanUrl = rawUrl.split('?')[0].replace(/\\/(shorts|videos|featured|playlists|community|about)\\/?$/, '');\n\n  // If URL already contains /channel/UC... we have the ID directly\n  let channelId = '';\n  if (cleanUrl.includes('/channel/')) {\n    channelId = cleanUrl.split('/channel/')[1].split('/')[0];\n  }\n\n  // Otherwise resolve handle → page scrape → extract UC channel ID\n  if (!channelId) {\n    // Build the canonical @handle URL to fetch\n    let handleUrl = '';\n    if (cleanUrl.includes('/@')) {\n      handleUrl = 'https://www.youtube.com/@' + cleanUrl.split('/@')[1].split('/')[0];\n    } else if (cleanUrl.includes('/c/')) {\n      // /c/ URLs redirect to /@handle — use the handle directly\n      handleUrl = 'https://www.youtube.com/@' + cleanUrl.split('/c/')[1].split('/')[0];\n    } else if (cleanUrl.includes('/user/')) {\n      handleUrl = 'https://www.youtube.com/@' + cleanUrl.split('/user/')[1].split('/')[0];\n    }\n\n    if (!handleUrl) {\n      console.log('Cannot build handle URL for: ' + rawUrl);\n      continue;\n    }\n\n    try {\n      const html = await this.helpers.httpRequest({\n        method: 'GET',\n        url: handleUrl,\n        headers: { 'User-Agent': 'Mozilla/5.0 (compatible; n8n-bot/1.0)' },\n        returnFullResponse: false\n      });\n\n      // Extract UC channel ID from page HTML\n      const match = html.match(/\\/channel\\/(UC[A-Za-z0-9_\\-]{22})/);\n      if (match) {\n        channelId = match[1];\n      } else {\n        console.log('Channel ID not found in page HTML for: ' + handleUrl);\n        continue;\n      }\n    } catch (e) {\n      console.log('Page fetch error for ' + handleUrl + ': ' + e.message);\n      continue;\n    }\n  }\n\n  // Now fetch channel name from YouTube channels API (still needs key)\n  // Instead: extract channel name from the same page scrape\n  // Re-fetch to get name — or use the Source Name field as fallback\n  let channelName = item.json['Source Name'] || '';\n\n  // Try to get the real channel name from the channels API\n  const API_KEY = 'AIzaSyCiu4jOmy7kvNLMU9KAFcHhIW8ZVfB4OkQ';\n  try {\n    const res = await this.helpers.httpRequest({\n      method: 'GET',\n      url: `https://www.googleapis.com/youtube/v3/channels?part=snippet&id=${channelId}&key=${API_KEY}`,\n      json: true\n    });\n    channelName = res.items?.[0]?.snippet?.title || channelName;\n  } catch (e) {\n    console.log('Channel name lookup failed for ' + channelId + ' (using Source Name): ' + e.message);\n    // channelName already set to Source Name fallback above\n  }\n\n  results.push({\n    json: { recordId, channelId, channelName }\n  });\n}\n\nreturn results;\n"
      },
