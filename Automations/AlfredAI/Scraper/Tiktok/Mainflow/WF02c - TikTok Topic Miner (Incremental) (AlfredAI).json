    {
      "parameters": {
        "jsCode": "\nconst sources = $input.all();\nif (!sources || sources.length === 0) {\n  return [{ json: { _skip: true, reason: 'No backfilled active sources' } }];\n}\nconst sourceMap = {};\nconst profiles = [];\nconst now = Date.now();\nconst fallback = new Date(now - 2 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];\nconst scanDates = [];\nfor (const s of sources) {\n  let raw = (s.json['TikTok_Handle'] || '').replace(/^@/, '').trim();\n  if (!raw) {\n    const url = (s.json['TikTok_Links'] || '');\n    const match = url.match(/tiktok\\.com\\/@([^/?]+)/);\n    if (match) raw = match[1].trim();\n  }\n  if (!raw) continue;\n  profiles.push('https://www.tiktok.com/@' + raw);\n  sourceMap[raw.toLowerCase()] = {\n    source_id: s.json.id || '',\n    source_name: s.json['Source Name'] || '',\n    handle: '@' + raw\n  };\n  const lastScanned = s.json['TikTok_Last_Scanned'];\n  if (lastScanned) scanDates.push(new Date(lastScanned).getTime());\n}\nif (!profiles.length) {\n  return [{ json: { _skip: true, reason: 'No valid handles found' } }];\n}\nlet publishedAfter = fallback;\nif (scanDates.length > 0) {\n  const bufferedTs = Math.min(...scanDates) - (1 * 24 * 60 * 60 * 1000);\n  publishedAfter = new Date(bufferedTs).toISOString().split('T')[0];\n}\nconsole.log('[2a] ' + profiles.length + ' profiles | publishedAfter=' + publishedAfter);\nreturn [{ json: { profiles, source_map: sourceMap, published_after: publishedAfter } }];\n"
      },
      "name": "2a. Prepare Apify Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -8480,
        -2032
      ],
      "id": "c92b03e4-55f9-424a-b08f-d7c26017bb14"
