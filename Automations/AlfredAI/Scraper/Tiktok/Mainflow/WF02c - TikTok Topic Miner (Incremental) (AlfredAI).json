    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/clockworks~tiktok-scraper/runs?token=REDACTED_APIFY&maxItems=400",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"profiles\": {{ JSON.stringify($json.profiles) }},\n  \"resultsPerPage\": 15,\n  \"profileSorting\": \"latest\",\n  \"publishedAfter\": \"{{ $json.published_after }}\",\n  \"shouldDownloadVideos\": false,\n  \"shouldDownloadCovers\": false,\n  \"shouldDownloadSubtitles\": false,\n  \"shouldDownloadAvatars\": false\n}",
        "options": {
