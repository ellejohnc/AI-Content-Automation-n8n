      "name": "1. Get Active TikTok Sources",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        -8704,
        -2032
      ],
      "id": "2466e191-c6ea-4b28-9f05-b75cf14c6cd9",
      "credentials": {
        "airtableOAuth2Api": {
          "id": "3nxfujQCXcfQc8IW",
