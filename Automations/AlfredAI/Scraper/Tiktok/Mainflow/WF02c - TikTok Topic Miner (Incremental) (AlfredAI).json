      "parameters": {
        "jsCode": "\nconst existingItems = $input.all();\nconst existingIds = new Set(existingItems.map(i => i.json['Video ID'] || '').filter(id => id !== ''));\nconst incomingItems = $('3. Extract & Flatten TikTok IDs').all();\nconst seenThisRun = new Set();\nconst newVideos = incomingItems.filter(item => {\n  if (item.json._skip) return false;\n  const vid = item.json.video_id;\n  if (!vid || existingIds.has(vid) || seenThisRun.has(vid)) return false;\n  seenThisRun.add(vid);\n  return true;\n});\nconsole.log('[5] Apify: ' + incomingItems.length + ' | Existing: ' + existingIds.size + ' | New: ' + newVideos.length);\nif (newVideos.length === 0) return [{ json: { _skip: true, video_id: '', source_id: '', source_name: '', url: '' } }];\nreturn newVideos;\n"
      },
      "name": "5. Filter New Videos Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
