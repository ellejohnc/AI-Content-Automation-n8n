    {
      "parameters": {
        "jsCode": "\n// Gate 1 per AlfredAI Outlier & Relevance Scoring Framework: OS >= 2.0x\n// Tiers: Mega-Viral (>5.0), Strong Outlier (2.0-5.0). Below 2.0 rejected.\nconst OUTLIER_THRESHOLD = 2.0;\nconst items = $input.all();\nconst outliers = [];\nconst skipped = [];\n\nfunction tierFor(score) {\n  if (score > 5.0) return 'Tier 1: Mega-Viral';\n  if (score >= 2.0) return 'Tier 2: Strong Outlier';\n  return null;\n}\n\nfor (const item of items) {\n  if (item.json._skip) continue;\n  const score = parseFloat(item.json.outlier_score) || 0;\n  const views = parseInt(item.json.view_count) || 0;\n  const title = (item.json.title || '').substring(0, 50);\n  const source = item.json.source_name || '';\n  const tier = tierFor(score);\n  if (tier) {\n    outliers.push({ json: { ...item.json, _skip: false, is_outlier: true, outlier_threshold: OUTLIER_THRESHOLD, outlier_tier: tier } });\n  } else {\n    skipped.push(source + ': \"' + title + '\" (score=' + score + ', views=' + views + ')');\n  }\n}\nif (skipped.length > 0) {\n  console.log('[5b] Skipped ' + skipped.length + ' below 2.0x:');\n  for (const s of skipped.slice(0, 10)) console.log('  - ' + s);\n  if (skipped.length > 10) console.log('  ... and ' + (skipped.length - 10) + ' more');\n}\nconsole.log('[5b] Outliers: ' + outliers.length + ' / ' + items.length + ' (Gate 1 threshold: ' + OUTLIER_THRESHOLD + 'x)');\nif (outliers.length === 0) return [{ json: { _skip: true, video_id: '', source_id: '', source_name: '', url: '' } }];\nreturn outliers;\n"
      },
