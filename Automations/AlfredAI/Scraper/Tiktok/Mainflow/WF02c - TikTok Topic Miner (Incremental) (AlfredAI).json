            }
          },
          "timeout": 30000
        }
      },
      "name": "2b. Run Apify Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -8256,
        -2032
      ],
      "id": "75a703e8-8764-4c4c-8b0a-859d475b7a9b"
    },
    {
      "parameters": {
        "jsCode": "\nconst apifyInput = $('2a. Prepare Apify Input').first().json;\nconst sourceMap = apifyInput.source_map || {};\nconst allVideos = $input.all()\n  .map(i => i.json)\n  .filter(v => v && typeof v === 'object' && !v.error && (v.id || v.video_id));\nconsole.log('[3] Apify returned ' + allVideos.length + ' total videos');\nif (!allVideos.length) {\n  return [{ json: { _skip: true, video_id: '', source_id: '', source_name: '', url: '' } }];\n}\n\nconst results = [];\nfor (const video of allVideos) {\n  const authorHandle = (\n    video['authorMeta.name'] ||\n    (video.authorMeta && video.authorMeta.name) || ''\n  ).toLowerCase().trim();\n  const sourceInfo = sourceMap[authorHandle] || { source_id: '', source_name: authorHandle, handle: '@' + authorHandle };\n  const videoId = String(video.id || video.video_id || '');\n  if (!videoId) continue;\n  const parseNum = (val) => {\n    if (val == null) return 0;\n    const s = String(val).replace(/,/g, '').trim();\n    if (s.endsWith('M')) return Math.round(parseFloat(s) * 1000000);\n    if (s.endsWith('K')) return Math.round(parseFloat(s) * 1000);\n    return parseInt(s) || 0;\n  };\n  const durationSec = parseInt(video['videoMeta.duration'] || (video.videoMeta && video.videoMeta.duration) || video.duration || 0);\n  const title = video.text || video.desc || video.description || '';\n  let tags = '';\n  if (Array.isArray(video.hashtags)) {\n    tags = video.hashtags.map(h => typeof h === 'string' ? h.replace(/^#/, '') : (h.name || h.title || '')).join(', ');\n  } else if (video.text) {\n    const found = video.text.match(/#[\\w\\u0080-\\uFFFF]+/g);\n    if (found) tags = found.map(h => h.replace(/^#/, '')).join(', ');\n  }\n  const url = video.webVideoUrl || 'https://www.tiktok.com/@' + authorHandle + '/video/' + videoId;\n  results.push({\n    video_id: videoId, source_id: sourceInfo.source_id, source_name: sourceInfo.source_name,\n    handle: sourceInfo.handle, title, description: title, tags, url,\n    view_count: parseNum(video.playCount), like_count: parseNum(video.diggCount),\n    comment_count: parseNum(video.commentCount), share_count: parseNum(video.shareCount || 0),\n    duration: durationSec, published_at: video.createTimeISO || '',\n    channel_id: authorHandle, content_type: 'TikTok', platform: 'TikTok'\n  });\n}\n\nif (!results.length) {\n  return [{ json: { _skip: true, video_id: '', source_id: '', source_name: '', url: '' } }];\n}\n\n// Per-creator baseline median over last 30 videos (Framework Part 1.1).\n// OS = views / channel median over last 30 videos. Single standard across all platforms.\n// DEFENSIVE: node 4 runs downstream; guard the reference.\nconst historyByChannel = {};\nlet _existingRecs = [];\ntry {\n  _existingRecs = $('4. Get All Existing Video IDs').all();\n} catch (e) {\n  console.log('[3] node 4 not executed yet, using current-run median');\n}\nfor (const rec of _existingRecs) {\n  const ch = (rec.json['Channel ID'] || '').toLowerCase().trim();\n  if (!ch) continue;\n  const v = parseInt(rec.json['View Count']) || 0;\n  const ts = rec.json['Published At'] || '';\n  if (!historyByChannel[ch]) historyByChannel[ch] = [];\n  historyByChannel[ch].push({ v, ts });\n}\n\nfunction median(arr) {\n  if (!arr.length) return 0;\n  const s = [...arr].sort((a, b) => a - b);\n  const mid = Math.floor(s.length / 2);\n  return s.length % 2 === 0 ? (s[mid - 1] + s[mid]) / 2 : s[mid];\n}\n\nconst currentByChannel = {};\nfor (const r of results) {\n  const ch = r.channel_id;\n  if (!currentByChannel[ch]) currentByChannel[ch] = [];\n  currentByChannel[ch].push({ v: r.view_count, ts: r.published_at });\n}\n\nconst baselineByChannel = {};\nconst allChannels = new Set([...Object.keys(historyByChannel), ...Object.keys(currentByChannel)]);\nfor (const ch of allChannels) {\n  const combined = [...(historyByChannel[ch] || []), ...(currentByChannel[ch] || [])]\n    .filter(x => x.v > 0)\n    .sort((a, b) => String(b.ts).localeCompare(String(a.ts)))\n    .slice(0, 30)\n    .map(x => x.v);\n  baselineByChannel[ch] = median(combined);\n  console.log('[3] @' + ch + ': baseline median (last ' + combined.length + '): ' + baselineByChannel[ch]);\n}\n\nconst scored = [];\nfor (const r of results) {\n  const baseline = baselineByChannel[r.channel_id] || 0;\n  const outlierScore = baseline > 0 ? parseFloat((r.view_count / baseline).toFixed(2)) : 0;\n  scored.push({ json: { ...r, outlier_score: outlierScore, baseline_median: baseline } });\n}\n\nconsole.log('[3] Total extracted: ' + scored.length);\nreturn scored;\n"
      },
