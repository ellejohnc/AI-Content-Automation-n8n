      "name": "1. Get All New Videos",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        -96,
        320
      ],
      "id": "6a76e35f-3830-42c5-b809-0b5c354d8b8a",
