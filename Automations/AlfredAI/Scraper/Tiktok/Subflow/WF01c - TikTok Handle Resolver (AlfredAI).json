    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n// FIX: hardcode API key — $credentials.X is not valid inside Code nodes\nconst SUPADATA_KEY = 'eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiIsImtpZCI6IjEifQ.eyJpc3MiOiJuYWRsZXMiLCJpYXQiOiIxNzQxNjk3Mzg2IiwicHVycG9zZSI6ImFwaV9hdXRoZW50aWNhdGlvbiIsInN1YiI6IjJmNDc1Yzg0OTBjNzQ0ZGNhMTJjODA3MzY3YzEzNTg1In0.th5iol8OEe8_Wkda7ENeG2WX_W7BnohBfGDb0_2v2SI';\nconst results = [];\n\nfor (const item of items) {\n  // FIX: read from TikTok_Links field (not generic Links)\n  const url      = item.json['TikTok_Links'] || item.json['Links'] || '';\n  const recordId = item.json.id;\n  let handle = '';\n\n  if (url.includes('tiktok.com/@')) {\n    handle = url.split('tiktok.com/@')[1].split('/')[0].split('?')[0].trim();\n  } else if (url.startsWith('@')) {\n    handle = url.replace('@', '').split('/')[0].trim();\n  } else if (url && !url.includes('/') && !url.includes('.')) {\n    handle = url.trim();\n  } else if (url.includes('tiktok.com/')) {\n    const part = url.split('tiktok.com/')[1].replace('@','').split('/')[0].split('?')[0].trim();\n    if (part) handle = part;\n  }\n\n  if (!handle) continue;\n\n  let displayName = handle;\n  try {\n    const profileResponse = await this.helpers.httpRequest({\n      method: 'GET',\n      url: `https://api.supadata.ai/v1/tiktok/user?username=${encodeURIComponent(handle)}`,\n      headers: { 'x-api-key': SUPADATA_KEY },\n      json: true\n    });\n    displayName = profileResponse.nickname || profileResponse.display_name || profileResponse.author?.displayName || handle;\n  } catch(e) {\n    console.log('Supadata profile lookup failed for @' + handle + ': ' + e.message);\n    displayName = handle;\n  }\n\n  results.push({\n    json: { recordId, handle: '@' + handle.replace(/^@/, ''), displayName }\n  });\n}\n\nreturn results;\n"
      },
