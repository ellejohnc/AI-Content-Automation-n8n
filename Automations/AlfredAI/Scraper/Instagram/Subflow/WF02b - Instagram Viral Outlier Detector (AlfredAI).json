    {
      "parameters": {
        "jsCode": "\n// Reads the document-compliant Outlier Score already computed and stored by WF02d\n// (Framework Part 1.1: views / channel median over last 30 videos).\n// WF02b does NOT recompute — single source of truth.\n// Document gate for Instagram: OS >= 2.5x, min 100 views.\nconst OUTLIER_THRESHOLD = 2.5;\nconst MIN_VIEWS = 100;\n\nconst items = $input.all();\nif (items.length === 0) return [];\n\nconst detectCategory = (text) => {\n  const t = (text || '').toLowerCase();\n  const edu = ['how to','full course','beginner','masterclass','tutorial','guide','explained',\n    'learn ','lessons','levels of',' tips','skills','stop using',\"here's the fix\",'step by step',\n    'complete guide','from scratch','for beginners','crash course','deep dive','walkthrough',\n    'how i use','how i build','setup'];\n  for (const kw of edu) { if (t.includes(kw)) return 'Education'; }\n  const prod = ['product intro','product demo','product launch','product review','unboxing',\n    'hands on','first look'];\n  for (const kw of prod) { if (t.includes(kw)) return 'Product'; }\n  return 'News';\n};\n\nconst outliers = [];\nlet belowGate = 0;\n\nfor (const item of items) {\n  const d = item.json;\n  const storedScore = parseFloat(d['Outlier Score'] || 0) || 0;\n  const vc = parseInt(d['View Count'] || 0, 10);\n\n  // Document gate (Instagram): OS >= 2.5x AND views > 100, using WF02d's stored score.\n  if (storedScore < OUTLIER_THRESHOLD || vc < MIN_VIEWS) { belowGate++; continue; }\n\n  const rawSources = d['Associated_Sources'] || [];\n  const sourceIds = Array.isArray(rawSources)\n    ? rawSources.map(r => (typeof r === 'object' ? r.id : r)).filter(Boolean)\n    : [];\n\n  outliers.push({ json: {\n    record_id:      d.id,\n    video_id:       d['Video ID'],\n    title:          d['Title'],\n    url:            d['URL'],\n    source_name:    d['Source Name'] || 'unknown',\n    creator_handle: d['Creator_Handle'] || '',\n    source_ids:     sourceIds,\n    platform:       'Instagram',\n    content_type:   d['Content Type'],\n    view_count:     vc,\n    outlier_score:  storedScore,\n    category:       detectCategory(d['Title'])\n  }});\n}\n\nconsole.log('[2] Instagram outliers (OS >= ' + OUTLIER_THRESHOLD + 'x, views >= ' + MIN_VIEWS + '): ' + outliers.length + ' | below gate: ' + belowGate);\nreturn outliers.sort((a, b) => b.json.outlier_score - a.json.outlier_score);\n"
      },
