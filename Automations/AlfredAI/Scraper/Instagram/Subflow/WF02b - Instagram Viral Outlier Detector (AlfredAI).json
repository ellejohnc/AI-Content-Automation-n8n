      "name": "1. Get All New Videos",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        7488,
        944
      ],
      "id": "dcbee7c6-a1e2-4c7e-9715-8c384a802d62",
