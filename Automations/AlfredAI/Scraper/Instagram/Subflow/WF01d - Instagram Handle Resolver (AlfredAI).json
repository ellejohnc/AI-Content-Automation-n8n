        },
        "filterByFormula": "AND(OR(FIND('instagram.com', {Instagram_Links}), NOT({Instagram_Links} = '')), {Instagram_Handle} = '')",
        "options": {}
      },
      "name": "1. Get Sources to Resolve",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        -336,
        -400
      ],
      "id": "d0eabb91-e4cc-4d3e-9167-17e2e9a26dcf",
      "credentials": {
        "airtableOAuth2Api": {
          "id": "3nxfujQCXcfQc8IW",
          "name": "Airtable OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const url = item.json['Instagram_Links'] || item.json['Links'] || '';\n  const recordId = item.json.id;\n  let handle = '';\n\n  if (!url) continue;\n\n  // Skip post/reel/tv/story paths — these are not profile URLs\n  const skipPaths = ['/p/', '/reel/', '/tv/', '/stories/', '/explore/'];\n  if (skipPaths.some(p => url.includes(p))) continue;\n\n  if (url.includes('instagram.com/@')) {\n    handle = url.split('instagram.com/@')[1].split('/')[0].split('?')[0].trim();\n  } else if (url.includes('instagram.com/')) {\n    const part = url.split('instagram.com/')[1].split('/')[0].split('?')[0].replace('@', '').trim();\n    if (part && part !== 'p' && part !== 'reel' && part !== 'tv' && part !== 'stories') {\n      handle = part;\n    }\n  } else if (url.startsWith('@')) {\n    handle = url.replace('@', '').split('/')[0].trim();\n  } else if (url && !url.includes('/') && !url.includes('.')) {\n    handle = url.trim();\n  }\n\n  if (!handle) {\n    console.log('Could not extract handle from: ' + url);\n    continue;\n  }\n\n  results.push({\n    json: { recordId, handle: '@' + handle.replace(/^@/, '') }\n  });\n}\n\nconsole.log('[2] Resolved ' + results.length + ' handles from ' + items.length + ' sources');\nreturn results;\n"
      },
      "name": "2. Resolve Instagram Handles",
