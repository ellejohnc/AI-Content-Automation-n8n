      "parameters": {
        "jsCode": "const record = $input.item.json;\nconst recordId = record.id || '';\nconst topic = (record['Topic'] || 'content');\nconst musicBgm = record['Music_BGM'] || '';\n\nconst blocks = musicBgm.split(/\\n\\n+/).filter(b => b.trim().length > 0);\n\nconst extractBlock = (block) => {\n  const lines = block.trim().split('\\n').map(l => l.trim()).filter(l => l.length > 0);\n  const variantLine = lines[0].replace(/^\\d+\\.\\s*/, '').replace(/\\s*\\(Part \\d+\\)\\s*/i, '').trim();\n  const promptText = lines.slice(1).join(' ').trim();\n  const prompt = promptText || `Background music for ${topic}. Style: ${variantLine}. Instrumental only, no vocals.`;\n  const safeName = variantLine\n    .replace(/\\s*—\\s*/g, '_')\n    .replace(/\\s*\\|\\s*/g, '_')\n    .replace(/\\s+/g, '_')\n    .replace(/[^a-zA-Z0-9_]/g, '')\n    .replace(/_+/g, '_')\n    .replace(/^_|_$/g, '')\n    .substring(0, 50)\n    .toLowerCase();\n  return { variant: variantLine, prompt, safeName };\n};\n\n// Short topic key — first 3 significant words, stop words removed\nconst stopWords = ['the','a','an','is','are','was','were','in','on','at','of','to','for','and','or','but','how','why','what','will','can','do','does','has','have','this','that','with','from'];\nconst topicKey = topic\n  .toLowerCase()\n  .replace(/[^a-z0-9\\s]/g, '')\n  .split(/\\s+/)\n  .filter(w => w.length > 0 && !stopWords.includes(w))\n  .slice(0, 3)\n  .join('_') || 'general';\n\nlet track1 = { variant: 'generic_bgm_part1', prompt: `Background music for a social media video about: ${topic}. Upbeat, corporate, instrumental, no vocals, part 1.`, safeName: 'generic_bgm_part1' };\nlet track2 = { variant: 'generic_bgm_part2', prompt: `Background music for a social media video about: ${topic}. Upbeat, corporate, instrumental, no vocals, part 2, higher energy.`, safeName: 'generic_bgm_part2' };\n\nif (blocks.length >= 1) track1 = extractBlock(blocks[0]);\nif (blocks.length >= 2) track2 = extractBlock(blocks[1]);\n\nconst filename1 = `BGM_${track1.safeName}_${topicKey}_part1.mp3`;\nconst filename2 = `BGM_${track2.safeName}_${topicKey}_part2.mp3`;\n\nconst transitionNote = `BGM TRANSITION: Part 1 (${track1.variant}) at 40% of video duration. Apply 0.5-1s crossfade at transition point.`;\n\nconst driveQuery1 = \"name = '\" + filename1 + \"' and '1MY0MhNjDbE48dz8DzweOirdMQ7LR1xrp' in parents and trashed = false\";\nconst driveQuery2 = \"name = '\" + filename2 + \"' and '1MY0MhNjDbE48dz8DzweOirdMQ7LR1xrp' in parents and trashed = false\";\n\nreturn {\n  json: {\n    record_id: recordId,\n    topic,\n    topicKey,\n    prompt1: track1.prompt,\n    prompt2: track2.prompt,\n    filename1,\n    filename2,\n    variant1: track1.variant,\n    variant2: track2.variant,\n    transition_note: transitionNote,\n    music_bgm_raw: musicBgm,\n    driveQuery1,\n    driveQuery2\n  }\n};"
      },
