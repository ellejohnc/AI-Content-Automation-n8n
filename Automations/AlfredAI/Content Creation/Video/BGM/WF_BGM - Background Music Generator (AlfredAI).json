      "parameters": {
        "jsCode": "const ctx = $('2. Build BGM Prompt').first().json;\nconst prompt2 = ctx.prompt2 || '';\n\nif (!prompt2) {\n  throw new Error('prompt2 is empty — Music_BGM may only have one block. Raw: ' + (ctx.music_bgm_raw || '').substring(0, 200));\n}\n\nconst body = JSON.stringify({\n  prompt: prompt2,\n  duration_ms: 45000,\n  output_format: \"mp3_44100_128\"\n});\n\nreturn {\n  json: {\n    ...$input.item.json,\n    track2_body: body,\n    prompt2_debug: prompt2.substring(0, 100)\n  }\n};"
