    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n// Airtable node v2.2 returns fields FLAT on the item; older shapes nest them\n// under .fields. Accept either, so a node version bump cannot silently empty\n// every field and push the record into Error - Motion Graphics Failed.\nconst f = (item.fields && typeof item.fields === 'object') ? item.fields : item;\nconst topic = f['Topic'] || '';\nconst topicSlug = topic.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');\nconst category = (f['Category'] || '').toString().trim();\nreturn {\n  json: {\n    record_id: item.id || '',\n    topic: topic,\n    topic_slug: topicSlug,\n    category: category,\n    video_url: f['AI_Video_URL'] || ''\n  }\n};"
      },
