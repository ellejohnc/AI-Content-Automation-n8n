      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst rawTopic = item['Topic'] || 'untitled';\nconst topic_slug = rawTopic\n  .replace(/[^a-zA-Z0-9\\s]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .replace(/\\s/g, '_')\n  .substring(0, 60)\n  .toLowerCase();\nreturn { json: {\n  record_id: item.id || '',\n  topic: rawTopic,\n  topic_slug: topic_slug\n}};"
      },
