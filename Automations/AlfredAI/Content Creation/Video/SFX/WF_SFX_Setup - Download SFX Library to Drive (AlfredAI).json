    {
      "parameters": {
        "jsCode": "const BASE = 'https://raw.githubusercontent.com/manthanpatelll/soundeffects-claude-code/main/sfx';\nconst files = [\n  { soundName: 'camera_shutter',  filename: 'camera_shutter.wav',  url: BASE + '/Camera%20Shutter%205.wav' },\n  { soundName: 'ding',            filename: 'ding.wav',             url: BASE + '/Correct%20Ding.wav' },\n  { soundName: 'impact',          filename: 'impact.wav',           url: BASE + '/Impact%207.wav' },\n  { soundName: 'keyboard',        filename: 'keyboard.wav',         url: BASE + '/Keyboard-Button-Click-06-c-FesliyanStudios.com_.wav' },\n  { soundName: 'mouse_click',     filename: 'mouse_click.wav',      url: BASE + '/Mouse%20Click.wav' },\n  { soundName: 'riser',           filename: 'riser.wav',            url: BASE + '/Riser%203.wav' },\n  { soundName: 'whoosh',          filename: 'whoosh.wav',           url: BASE + '/Whoosh%201.wav' },\n  { soundName: 'air_hit',         filename: 'air_hit.wav',          url: BASE + '/mixkit-air-in-a-hit-2161.wav' },\n  { soundName: 'notification',    filename: 'notification.wav',     url: BASE + '/mixkit-bike-notification-bell-590.wav' },\n  { soundName: 'digital_shutter', filename: 'digital_shutter.wav',  url: BASE + '/mixkit-camera-digital-shutter-1432.wav' },\n  { soundName: 'double_click',    filename: 'double_click.wav',     url: BASE + '/mixkit-fast-double-click-on-mouse-275.wav' },\n  { soundName: 'digital_readout', filename: 'digital_readout.wav',  url: BASE + '/textdigitalreadout.wav' }\n];\nreturn files.map(f => ({ json: f }));"
      },
      "id": "64c18988-7467-4c74-abca-875e24325e4f",
      "name": "1. SFX File List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
