    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst folderId = '1NdWG8ggfJg5tRXtQxRdE3yhlFUezbaA4';\nreturn [{\n  json: {\n    url: item.url,\n    filename: item.filename,\n    soundName: item.soundName,\n    driveQuery: `name = '${item.filename}' and '${folderId}' in parents and trashed = false`\n  }\n}];"
      },
      "id": "66fa8d54-70fb-429b-8f0f-17f44b5364c2",
