    {
      "parameters": {
        "jsCode": "const record = $input.item.json;\nconst recordId = record.id || '';\nconst sfxRaw = record['Sound_Effects'] || '';\n\nconst KNOWN_SOUNDS = ['digital_readout','whoosh','impact','riser','ding','air_hit','keyboard','mouse_click','double_click','notification','camera_shutter','digital_shutter'];\n\nconst lines = sfxRaw.split('\\n').filter(l => l.trim().length > 0);\nconst sounds = [];\n\nfor (const line of lines) {\n  const stripped = line.replace(/^\\d+\\.\\s*/, '').trim();\n  let soundName = '';\n  let cue = '';\n\n  const atMatch = stripped.match(/^([a-z_]+)\\s+at\\s+([\\d:]+)/i);\n  if (atMatch) {\n    soundName = atMatch[1].toLowerCase();\n    cue = atMatch[2];\n  } else {\n    soundName = (stripped.split(/[\\s|\\u2014\\-]/)[0] || '').toLowerCase().replace(/[^a-z_]/g, '');\n  }\n\n  if (!soundName || !KNOWN_SOUNDS.includes(soundName)) continue;\n  sounds.push({ soundName, cue, filename: soundName + '.wav', index: sounds.length + 1 });\n}\n\nreturn [{ json: { record_id: recordId, sounds } }];"
      },
      "id": "e895edfa-df63-4705-989f-cc186e9051a7",
      "name": "2. Parse Sound Effects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4320,
        -784
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
