            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c70147a0-0c57-4522-84fe-0a08da12d69f",
      "name": "3. Has Sounds?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        4560,
        -784
