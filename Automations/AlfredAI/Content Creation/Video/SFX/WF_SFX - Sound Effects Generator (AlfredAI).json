    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst folderId = '1NdWG8ggfJg5tRXtQxRdE3yhlFUezbaA4';\n\n// Build a single OR query for all filenames at once\nconst nameConditions = data.sounds.map(s => `name = '${s.filename}'`).join(' or ');\nconst driveQuery = `(${nameConditions}) and '${folderId}' in parents and trashed = false`;\n\nreturn [{ json: { record_id: data.record_id, sounds: data.sounds, driveQuery } }];"
      },
      "id": "67fd9765-0c0d-4cae-aab4-dce53247908a",
      "name": "4. Build Batch Drive Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4800,
        -784
      ]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.driveQuery }}"
            },
            {
              "name": "fields",
              "value": "files(id,name)"
            },
            {
              "name": "pageSize",
              "value": "20"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            },
            {
              "name": "includeItemsFromAllDrives",
              "value": "true"
            },
            {
              "name": "corpora",
              "value": "allDrives"
            }
          ]
        },
        "options": {}
      },
      "id": "8b063c1a-5e62-4fad-ab41-b0bbef58bb32",
      "name": "5. Search Drive (All Files at Once)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        5040,
        -784
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "7MiXOLRTKPKVCXey",
          "name": "Google Drive account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const driveResult = $input.item.json;\nconst ctx = $('4. Build Batch Drive Query').item.json;\n\n// Build a lookup map: filename -> Drive file ID\nconst fileMap = {};\nfor (const f of (driveResult.files || [])) {\n  fileMap[f.name] = f.id;\n}\n\n// Build the numbered URL list in original order\nconst urlLines = ctx.sounds.map((s, i) => {\n  const fileId = fileMap[s.filename] || '';\n  const url = fileId ? `https://drive.google.com/uc?export=download&id=${fileId}` : 'NOT_FOUND';\n  const cue = s.cue ? ` at ${s.cue}` : '';\n  return `${i + 1}. ${s.soundName}${cue}: ${url}`;\n}).join('\\n');\n\nreturn [{ json: { record_id: ctx.record_id, sound_effects_url: urlLines } }];"
      },
      "id": "7f2b8059-d010-4036-aba0-6427812949a4",
      "name": "6. Map Files to URLs",
