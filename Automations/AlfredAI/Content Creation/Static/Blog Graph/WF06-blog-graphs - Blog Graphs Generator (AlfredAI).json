    {
      "parameters": {
        "jsCode": "const resp=$input.item.json||{};\nconst ctx=$('6. Build Manus Message').item.json;\nconst project='JEq3qMi5b5KjJZPAyq73DX';\nconst wanted='alfredai-blog-graphs';\nconst source='workflow default';\nconst rec=ctx.record_id||'(no id)';\nif(resp.ok===false||!Array.isArray(resp.data)){throw new Error('skill.list failed for Manus project '+project+' on record '+rec+': '+JSON.stringify(resp).substring(0,300)+'. Nothing submitted.');}\nconst all=resp.data.filter(Boolean);\nconst norm=s=>String(s||'').trim().toLowerCase();\nconst projectSkills=all.filter(s=>s.owner_type==='project');\nconst matches=projectSkills.filter(s=>norm(s.name)===norm(wanted));\nif(matches.length!==1||!matches[0].id){\n  const nonProject=all.filter(s=>s.owner_type!=='project'&&norm(s.name)===norm(wanted)).map(s=>(s.owner_type||'unknown')+' '+s.id);\n  let why;\n  if(matches.length>1)why=matches.length+' project skills share this name ('+matches.map(s=>s.id).join(', ')+')';\n  else if(nonProject.length)why='only non-project copies exist ['+nonProject.join(', ')+']; personal, team, official and app skills are not allowed';\n  else why='no project skill with this name';\n  throw new Error('Skill '+wanted+' ('+source+') not resolved for record '+rec+' in Manus project '+project+': '+why+'. Project skills available: '+(projectSkills.map(s=>s.name).join(', ')||'(none)')+'. Nothing submitted.');\n}\nconst hit=matches[0];\nreturn{json:{...ctx,manus_project_id:project,resolved_skill_id:hit.id,resolved_skill_name:hit.name||wanted,resolved_skill_owner_type:hit.owner_type,resolved_skill_source:source,skill_resolve_error:''}};"
      },
