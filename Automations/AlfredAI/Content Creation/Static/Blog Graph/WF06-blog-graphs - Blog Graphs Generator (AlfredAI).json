      "parameters": {
        "jsCode": "const item=$input.item.json;\nconst topic=item['Topic']||'';\nconst sourceUrl=item['Source URL']||item['Source_URL']||'';\nconst mediaRaw=item['Source_Media_URLs']||'';\nconst firstMedia=mediaRaw.split('\\n').map(s=>s.trim()).filter(Boolean)[0]||'';\nconst feed=sourceUrl||firstMedia;\nconst client=(item['Client']&&typeof item['Client']==='object')?(item['Client'].name||''):(item['Client']||'AlfredAI');\nconst existingNotes=item['Static_Notes']||'';\nconst STAGE_TAG='BLOG GRAPHS (skill)';\nconst sep='==============================';\nconst blockRe=new RegExp('\\\\n*'+sep+'\\\\n'+STAGE_TAG.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&')+'[\\\\s\\\\S]*?(?=(\\\\n'+sep+'\\\\n)|$)','g');\nconst notesBase=existingNotes.replace(blockRe,'').trim();\nreturn{json:{record_id:item.id||'',topic,source_url:sourceUrl,source_media:firstMedia,feed_link:feed,client,notes_base:notesBase,stage_tag:STAGE_TAG,sep,has_feed:!!(feed&&feed.trim().length>5)}};"
