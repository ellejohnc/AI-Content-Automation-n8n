    {
      "parameters": {
        "jsCode": "let ctx;\ntry{ctx=$('4e. Extract Folder ID').item.json;}catch(e){ctx=$('4e. Extract Folder ID').last().json;}\nconst e=$input.item.json||{};\nconst raw=e.error;\nconst reason=String(typeof raw==='string'?raw:(raw&&(raw.message||raw.description))||JSON.stringify(e)).substring(0,1500);\nlet skill='';\ntry{const p=$('6c. Pick Skill').item.json;if(p&&p.resolved_skill_id)skill=p.resolved_skill_name+' ('+p.resolved_skill_owner_type+', '+p.resolved_skill_id+')';}catch(err){}\nconst lines=[ctx.sep,ctx.stage_tag,'Updated: '+$now.toFormat('yyyy-MM-dd HH:mm'),'FAILED - Manus task not created; record not marked ready.','Reason: '+reason];\nif(skill)lines.push('Skill: '+skill);\nlines.push('Source: '+(ctx.feed_link||''),'Drive folder: '+(ctx.drive_folder_url||''));\nconst notes=(ctx.notes_base?ctx.notes_base+'\\n\\n':'')+lines.join('\\n');\nreturn{json:{record_id:ctx.record_id,failure_reason:reason,failure_skill:skill,failure_notes:notes}};"
