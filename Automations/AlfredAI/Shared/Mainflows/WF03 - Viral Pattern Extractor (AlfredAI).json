      "name": "3b. Universal Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        2560,
        1488
      ],
      "id": "fd478e01-9ac6-4f40-aee7-3802320a3482",
      "credentials": {
        "httpHeaderAuth": {
          "id": "L01j4MGWxdfH53sL",
