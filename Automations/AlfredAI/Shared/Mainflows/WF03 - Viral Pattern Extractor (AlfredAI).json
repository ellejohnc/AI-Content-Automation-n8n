    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REDACTED_OPENAI"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4.1-mini\",\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are an expert viral content analyst. Extract the viral pattern from a transcript. Always respond in this exact format with no extra text:\\n\\nHOOK_TYPE: [one short label e.g. Curiosity Gap, Bold Claim, Story Open, Question, Stat/Fact, Transformation, Controversy]\\nSTRUCTURE_TAG: [one short label e.g. Problem-Solution, List-Based, Tutorial, Story-Arc, News-React, Before-After]\\nPATTERN: [full reusable pattern e.g. Hook > Problem > 3 Examples > Insight > CTA]\" },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify(\"Analyze this transcript and extract the viral pattern.\\n\\nTRANSCRIPT:\\n\" + $json.transcript) }}\n    }\n  ],\n  \"max_tokens\": 300,\n  \"temperature\": 0.3\n}",
        "options": {}
      },
      "name": "5. Analyze Pattern (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        3232,
        1296
      ],
      "id": "91fa40a6-b238-4f4f-983f-e7d13cd16b6d"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst transcriptData = $('4. Standardize Transcript').item.json;\n\nlet content = '';\ntry {\n  if (response?.choices?.[0]?.message?.content) {\n    content = response.choices[0].message.content;\n  } else if (response?.error) {\n    console.log('[WF03] OpenAI API error:', response.error);\n    content = 'PATTERN_ANALYSIS_FAILED';\n  } else {\n    console.log('[WF03] Unexpected OpenAI response structure:', Object.keys(response || {}));\n    content = 'PATTERN_ANALYSIS_FAILED';\n  }\n} catch(e) {\n  console.log('[WF03] Error parsing OpenAI response:', e.message);\n  content = 'PATTERN_ANALYSIS_FAILED';\n}\n\nconst hookMatch      = content.match(/HOOK_TYPE:\\s*(.+)/i);\nconst structureMatch = content.match(/STRUCTURE_TAG:\\s*(.+)/i);\nconst patternMatch   = content.match(/PATTERN:\\s*(.+)/i);\n\nreturn { json: {\n  record_id:        transcriptData.record_id,\n  transcript:       transcriptData.transcript,\n  creator_handle:   transcriptData.creator_handle || '',\n  hook_type:        hookMatch      ? hookMatch[1].trim().substring(0,100)     : 'Unknown',\n  structure_tag:    structureMatch ? structureMatch[1].trim().substring(0,100) : 'Unknown',\n  reusable_pattern: patternMatch   ? patternMatch[1].trim().substring(0,900)   : content.trim().substring(0,900)\n} };"
      },
