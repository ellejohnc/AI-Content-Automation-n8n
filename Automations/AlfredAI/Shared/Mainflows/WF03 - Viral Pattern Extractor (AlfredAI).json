    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst originalData = $('2. Extract Video ID').item.json;\n\nlet transcript = 'TRANSCRIPT_UNAVAILABLE';\nlet isRateLimited = false;\n\nconst extractText = (content) => {\n  if (!content) return null;\n  if (typeof content === 'string') return content.trim();\n  if (Array.isArray(content)) return content.map(c => c.text || c.content || '').join(' ').trim();\n  return null;\n};\n\n// Supadata returns errors as both plain objects AND array-wrapped objects\n// e.g. [{\"error\": \"limit-exceeded\", \"message\": \"Limit Exceeded\", ...}]\nconst body = Array.isArray(response) ? response[0] : response;\n\nconst statusCode = body.statusCode || body.status || 0;\nconst errorCode  = (body.error || '').toLowerCase();\n\nif (errorCode) {\n  // Any error field in the body — check for rate/limit errors first\n  if (\n    errorCode === 'limit-exceeded' ||\n    errorCode === 'rate-limit' ||\n    errorCode === 'rate_limit' ||\n    errorCode === 'too-many-requests' ||\n    errorCode === 'quota-exceeded' ||\n    statusCode === 429\n  ) {\n    console.log('[WF03] Supadata limit/rate error:', body.error, body.message);\n    isRateLimited = true;\n    transcript = 'TRANSCRIPT_RATE_LIMITED';\n  } else if (statusCode === 401 || statusCode === 403) {\n    console.log('[WF03] Supadata auth error:', statusCode);\n    transcript = 'TRANSCRIPT_AUTH_ERROR';\n  } else {\n    console.log('[WF03] Supadata error:', body.error, body.message);\n    transcript = 'TRANSCRIPT_UNAVAILABLE';\n  }\n} else if (statusCode >= 400) {\n  // HTTP-level error with no body error field\n  if (statusCode === 429) {\n    isRateLimited = true;\n    transcript = 'TRANSCRIPT_RATE_LIMITED';\n  } else if (statusCode === 401 || statusCode === 403) {\n    transcript = 'TRANSCRIPT_AUTH_ERROR';\n  } else {\n    transcript = 'TRANSCRIPT_UNAVAILABLE';\n  }\n} else {\n  // Successful response — extract transcript text\n  const immediateContent = body.content || body.data?.content || body.result?.content || null;\n  if (immediateContent) {\n    const text = extractText(immediateContent);\n    if (text) transcript = text;\n  }\n}\n\nconst isUnavailable = !transcript\n  || transcript === 'TRANSCRIPT_UNAVAILABLE'\n  || transcript === 'TRANSCRIPT_AUTH_ERROR';\n\nreturn [{ json: {\n  transcript:          transcript,\n  record_id:           originalData.record_id || '',\n  creator_handle:      originalData.creator_handle || '',\n  url:                 originalData.url || '',\n  platform:            originalData.platform || '',\n  existing_transcript: originalData.existing_transcript || '',\n  has_transcript:      !isUnavailable && !isRateLimited,\n  rate_limited:        isRateLimited,\n  raw_api_response:    body\n}}];"
      },
