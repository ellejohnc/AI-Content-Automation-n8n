    {
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REDACTED_PERPLEXITY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"sonar\",\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are a fact-checking assistant. For each claim, determine if it is VERIFIED, UNVERIFIED, or FALSE. Provide source URLs. Return JSON with: results (array of {claim_number, status, source_url, notes}), overall_status ('Verified'/'Failed'/'Partial'), source_links (comma-separated URLs). Return ONLY valid JSON.\" },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify(\"Verify these claims:\\n\\n\" + $json.claims_text) }} }\n  ],\n  \"max_tokens\": 2000\n}",
        "options": {}
      },
      "name": "7. Verify Claims (Perplexity)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        464,
        -112
      ],
      "id": "61128c0e-c43f-4869-b23d-27031a14a291",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst sourceData = $('5. Parse Claims').item.json;\n\nlet verificationData = {};\ntry {\n  const content = response.choices[0].message.content;\n  const cleanContent = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  verificationData = JSON.parse(cleanContent);\n} catch (e) {\n  verificationData = { overall_status: 'Manual Review Needed', source_links: '', results: [] };\n}\n\nconst overallStatus = verificationData.overall_status || 'Manual Review Needed';\nconst sourceLinks = verificationData.source_links || '';\n\nlet summary = '';\nif (verificationData.results && verificationData.results.length > 0) {\n  summary = verificationData.results.map(r => \n    `Claim ${r.claim_number}: ${r.status} - ${r.notes || ''} ${r.source_url ? '(' + r.source_url + ')' : ''}`\n  ).join('\\n');\n}\n\nlet airtableStatus = 'Verified'; // Status field value\nlet factCheckStatus = 'Passed'; // Fact_Check_Status field value\nif (overallStatus === 'Failed') { airtableStatus = 'Failed'; factCheckStatus = 'Failed'; }\nelse if (overallStatus === 'Partial' || overallStatus === 'Manual Review Needed') { airtableStatus = 'Needs Review'; factCheckStatus = 'In Review'; }\n\nreturn {\n  json: {\n    record_id: sourceData.record_id,\n    fact_check_status: airtableStatus,\n    fact_check_status_field: factCheckStatus,\n    verification_summary: summary,\n    source_links: sourceLinks,\n    overall_status: overallStatus\n  }\n};"
      },
