        "jsCode": "// Reached when no claims were verified: either extraction failed or it returned zero claims.\n// Neither case may resolve to Verified, so the review state is set explicitly.\nconst sourceData = $input.item.json;\nreturn {\n  json: {\n    record_id: sourceData.record_id,\n    fact_check_status: 'Needs Review',\n    fact_check_status_field: 'In Review',\n    verification_summary: sourceData.verification_results || 'No factual claims extracted from script - sent to review.',\n    source_links: '',\n    overall_status: sourceData.extraction_failed ? 'Extraction Failed' : 'No Claims'\n  }\n};"
