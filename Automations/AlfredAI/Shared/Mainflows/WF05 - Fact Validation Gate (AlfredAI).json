{
  "name": "WF05 - Fact Validation Gate (AlfredAI)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst category = (item['Category'] || '').toLowerCase();\nconst script = item['Script'] || '';\n\nconst isNews = category.includes('news') || category.includes('data') || category.includes('report');\nconst hasNumbers = /\\d+%|\\$\\d|\\d+ (million|billion|thousand|percent)/i.test(script);\nconst hasVerifyTags = script.includes('[VERIFY]');\nconst needsFactCheck = isNews || hasNumbers || hasVerifyTags;\n\nreturn {\n  json: {\n    record_id: item.id || '',\n    topic: item['Topic'] || '',\n    category: item['Category'] || 'General',\n    script: script,\n    source_url: item['Source URL'] || '',\n    platform: item['Platform'] || 'YouTube',\n    content_type: item['Content Type'] || 'Video',\n    needs_fact_check: needsFactCheck\n  }\n};"
      },
      "name": "2. Extract & Evaluate Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        80
      ],
      "id": "698867de-0d44-4235-90bc-63f2cf40d158"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.needs_fact_check }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "3. Needs Fact Check?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -432,
        80
      ],
      "id": "f840d65a-0e7c-4443-a7a1-d2f5adc23acb"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4.1-mini\",\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are a fact-checking assistant. Extract ALL factual claims from the script that need verification. Return a JSON object with: claims (array of {claim_text, claim_type, search_query}). If no claims, return {\\\"claims\\\": []}. Return ONLY valid JSON.\" },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify(\"Extract factual claims from this script:\\n\\n\" + $json.script) }} }\n  ],\n  \"temperature\": 0.1,\n  \"max_tokens\": 1500\n}",
        "options": {}
      },
      "name": "4. Extract Claims (ChatGPT)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -208,
        -16
      ],
      "id": "4c02e469-f3bc-4f67-81e9-d37e2ecfa5b3",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpBearerAuth": {
          "id": "x9t1HtZVkPLKi1dp",
          "name": "OpenAI Bearer Token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst sourceData = $('2. Extract & Evaluate Record').item.json;\n\n// A failed or unusable extraction is never 'no claims'. It is flagged and sent to review.\nconst fail = (reason) => ({ json: { ...sourceData, claims: [], all_verified: true, extraction_failed: true, verification_results: 'FACT CHECK DID NOT RUN - ' + reason + ' Manual review needed.', source_links: '' } });\n\nif (response.error || !response.choices || !response.choices[0] || !response.choices[0].message) {\n  const msg = typeof response.error === 'string' ? response.error : JSON.stringify(response.error || 'no choices returned');\n  return fail('Claim extraction call failed: ' + msg + '.');\n}\n\nlet claimsData = null;\ntry {\n  const content = response.choices[0].message.content;\n  const cleanContent = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  claimsData = JSON.parse(cleanContent);\n} catch (e) {\n  return fail('Claim extraction returned unparseable output.');\n}\n\nif (!claimsData || !Array.isArray(claimsData.claims)) {\n  return fail('Claim extraction returned no claims array.');\n}\n\nif (claimsData.claims.length === 0) {\n  return { json: { ...sourceData, claims: [], all_verified: true, extraction_failed: false, verification_results: 'No factual claims extracted from script - sent to review.', source_links: '' } };\n}\n\nconst claimsList = claimsData.claims.map((c, i) => `${i+1}. ${c.claim_text} [Search: ${c.search_query}]`).join('\\n');\n\nreturn { json: { ...sourceData, claims: claimsData.claims, claims_text: claimsList, all_verified: false, extraction_failed: false, verification_results: '', source_links: '' } };"
      },
      "name": "5. Parse Claims",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        -16
      ],
      "id": "244c12cc-3af5-4250-a665-9103569ec529"
