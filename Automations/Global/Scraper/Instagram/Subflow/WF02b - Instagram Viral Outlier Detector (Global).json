      "name": "1. Get All New Videos",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        8160,
        704
      ],
      "id": "f5c9f056-88bf-44e6-9d8a-11998698c819",
      "alwaysOutputData": true,
