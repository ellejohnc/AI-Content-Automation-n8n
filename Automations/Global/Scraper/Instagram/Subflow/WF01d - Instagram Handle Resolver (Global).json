          "value": "tbloAZ3EVCtVtCJrj"
        },
        "filterByFormula": "AND(OR(FIND('instagram.com', {Instagram_Links}), NOT({Instagram_Links} = '')), {Instagram_Handle} = '')",
        "options": {}
      },
      "name": "1. Get Sources to Resolve",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        336,
        -448
      ],
      "id": "cdfc8e80-9752-48d5-aa91-e8a2873c72ff",
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": {
          "id": "Zogs9vNOWILOB0or",
          "name": "Airtable Access Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nconst RESERVED = ['p','reel','reels','tv','stories','explore','accounts','directory','about','legal','developer'];\n\nfor (const item of items) {\n  const cfg = item.json.cfg || {};\n  const recordId = item.json.id;\n  const raw = (item.json['Instagram_Links'] || item.json['Instagram_Handle'] || '').trim();\n  if (!recordId) continue;\n\n  const fail = function (msg) { results.push({ json: { recordId, cfg, handle: '', resolved: false, resolve_error: msg } }); };\n\n  if (!raw) { fail('Instagram_Links is empty.'); continue; }\n\n  const skipPaths = ['/p/', '/reel/', '/reels/', '/tv/', '/stories/', '/explore/'];\n  if (skipPaths.some(function (p) { return raw.includes(p); })) {\n    fail('URL points at a post or reel, not a profile: ' + raw);\n    continue;\n  }\n\n  let handle = '';\n  if (raw.includes('instagram.com/@')) {\n    handle = raw.split('instagram.com/@')[1].split('/')[0].split('?')[0].trim();\n  } else if (raw.includes('instagram.com/')) {\n    handle = raw.split('instagram.com/')[1].split('/')[0].split('?')[0].replace(/^@/, '').trim();\n  } else if (raw.startsWith('@')) {\n    handle = raw.replace(/^@/, '').split('/')[0].split('?')[0].trim();\n  } else if (!raw.includes('/') && !raw.includes('.')) {\n    handle = raw.trim();\n  }\n\n  handle = handle.replace(/^@/, '');\n\n  if (!handle) { fail('Could not derive an Instagram handle from: ' + raw); continue; }\n  if (RESERVED.indexOf(handle.toLowerCase()) !== -1) { fail('Derived a reserved Instagram path, not a profile handle: ' + handle); continue; }\n\n  results.push({ json: { recordId, cfg, handle: '@' + handle, resolved: true, resolve_error: '' } });\n}\n\nreturn results;"
      },
