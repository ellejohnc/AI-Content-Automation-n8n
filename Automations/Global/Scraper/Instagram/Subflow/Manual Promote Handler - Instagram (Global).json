        -1216,
        -144
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "18c93d90-64eb-4f5d-8ba5-14701f59d326",
      "name": "0c. Client Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -992,
        -144
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const loop = $('0c. Client Loop');\nlet cfg = null;\ntry { cfg = loop.item.json; } catch (e) { cfg = null; }\nif (!cfg || !cfg.video_base_id) { throw new Error('Could not resolve client config for this iteration.'); }\nreturn { json: { ...$input.item.json, cfg } };"
      },
      "id": "cb7d0291-8242-4d42-8988-eaf286a04527",
      "name": "1c. Attach Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -544,
        -416
      ]
    },
    {
      "parameters": {
        "jsCode": "// Airtable search emits one item per input, so lookups align 1:1 with the video rows.\nconst lookups = $input.all();\nconst ctx = $('1c. Attach Config').all();\nreturn lookups.map((l, i) => {\n  const v = (ctx[i] && ctx[i].json) ? ctx[i].json : {};\n  const found = l.json || {};\n  const srcRaw = v.Associated_Sources || [];\n  return { json: {\n    cfg: v.cfg,\n    video_record_id: v.id || '',\n    title: v.Title || '',\n    url: v.URL || '',\n    source_name: v['Source Name'] || '',\n    creator_handle: v['Creator_Handle'] || v['Source Name'] || '',\n    source_ids: Array.isArray(srcRaw) ? srcRaw.map(r => (typeof r === 'object' ? r.id : r)).filter(Boolean) : [],\n    re_dupe_id: found.id || ''\n  } };\n});"
      },
      "id": "f50ddeb1-d3bf-4c4a-a3b8-9534b230909d",
      "name": "3a1. Merge RE Lookup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
