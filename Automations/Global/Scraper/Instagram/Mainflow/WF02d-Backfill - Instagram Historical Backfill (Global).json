      "parameters": {
        "jsCode": "const srcItems = $('1c. Attach Config').all().map(i => i.json);\nconst cfg = (srcItems[0] || {}).cfg || {};\nconst sources = srcItems.filter(s => s && s.id);\nconst out = [];\n\nfor (const s of sources) {\n  let handle = (s['Instagram_Handle'] || '').replace(/^@/, '').trim();\n  if (!handle) {\n    const url = (s['Instagram_Links'] || s['Links'] || '');\n    const match = url.match(/instagram\\.com\\/([^/?#]+)/);\n    if (match && !['p','reel','tv','explore','stories'].includes(match[1])) handle = match[1].trim();\n  }\n  if (!handle) continue;\n  out.push({ json: { _skip: false, cfg, source_id: s.id || '', source_name: s['Source Name'] || '', handle: '@' + handle, channel_key: handle.toLowerCase(), directUrls: ['https://www.instagram.com/' + handle + '/'] } });\n}\n\nif (!out.length) { return [{ json: { _skip: true, cfg, source_id: '', source_name: '' } }]; }\nconsole.log('[2a] Sources to backfill: ' + out.length);\nreturn out;"
      },
