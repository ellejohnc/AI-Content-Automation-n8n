    {
      "parameters": {
        "jsCode": "// Gate 1: OS >= threshold. Tiers: Mega-Viral (>5.0), Strong Outlier (>=2.0).\nconst OUTLIER_THRESHOLD = 2.0;\nconst incoming = $input.all();\nconst cfg = (incoming[0] && incoming[0].json && incoming[0].json.cfg) || {};\n\nfunction tierFor(score) {\n  if (score > 5.0) return 'Tier 1: Mega-Viral';\n  if (score >= OUTLIER_THRESHOLD) return 'Tier 2: Strong Outlier';\n  return null;\n}\n\nlet existingRecs = [];\ntry { existingRecs = $('5. Get All Existing Video IDs').all(); } catch (e) {}\nconst existingIds = new Set(existingRecs.map(i => i.json['Video ID'] || '').filter(id => id !== ''));\n\nconst seenThisRun = new Set();\nconst outliers = [];\nlet skippedDupe = 0;\nlet skippedThreshold = 0;\n\nfor (const item of incoming) {\n  if (item.json._skip) continue;\n  const vid = item.json.video_id;\n  if (!vid || existingIds.has(vid) || seenThisRun.has(vid)) { skippedDupe++; continue; }\n  seenThisRun.add(vid);\n  const score = parseFloat(item.json.outlier_score) || 0;\n  const tier = tierFor(score);\n  if (tier) { outliers.push({ json: { ...item.json, is_outlier: true, outlier_threshold: OUTLIER_THRESHOLD, outlier_tier: tier } }); }\n  else { skippedThreshold++; }\n}\n\nconsole.log('[6] Dupes: ' + skippedDupe + ' | Below threshold: ' + skippedThreshold + ' | Outliers: ' + outliers.length);\nif (!outliers.length) { return [{ json: { _skip: true, cfg } }]; }\nreturn outliers;"
      },
