        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"directUrls\": {{ JSON.stringify($json.directUrls) }},\n  \"resultsType\": \"posts\",\n  \"resultsLimit\": 30,\n  \"addParentData\": false,\n  \"onlyPostsNewerThan\": \"{{ new Date(new Date().getFullYear(), 0, 1).toISOString().split('T')[0] }}\"\n}",
        "options": {
