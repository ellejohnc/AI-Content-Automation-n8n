      "name": "3. Run Apify Backfill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -5312,
        -1216
      ],
      "id": "938100e6-f5f5-4116-9ff9-ba42c4f68bf3",
      "credentials": {
        "apifyApi": {
          "id": "Eq5ACNBTBaqokiL7",
          "name": "Apify account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const sources = $('2a. Prepare Single Source Input').all().map(i => i.json).filter(s => !s._skip);\nconst cfg = (sources[0] || {}).cfg || {};\nconst sourceMap = {};\nfor (const s of sources) { if (s.channel_key) sourceMap[s.channel_key] = s; }\n\nconst currentYear = new Date().getFullYear();\nconst currentYearStart = currentYear + '-01-01';\n\nconst allPosts = $input.all().map(i => i.json).filter(v => v && typeof v === 'object' && !v.error);\nconsole.log('[4] Apify returned ' + allPosts.length + ' total posts');\nif (!allPosts.length) { return [{ json: { _skip: true, cfg } }]; }\n\nconst parseNum = (val) => {\n  if (val == null) return 0;\n  const s = String(val).replace(/,/g, '').trim();\n  if (s.endsWith('M')) return Math.round(parseFloat(s) * 1000000);\n  if (s.endsWith('K')) return Math.round(parseFloat(s) * 1000);\n  return parseInt(s) || 0;\n};\n\nconst results = [];\nfor (const post of allPosts) {\n  const postType = (post.type || post.productType || post.__typename || '').toUpperCase();\n  if (postType === 'IMAGE' || postType === 'CAROUSEL_ALBUM' || postType === 'SIDECAR') continue;\n  const hasVideoSignal = post.videoPlayCount != null || post.videoViewCount != null || post.playsCount != null || post.videoDuration != null || post.isVideo === true;\n  if (!hasVideoSignal && postType === '') continue;\n\n  const publishedAt = post.timestamp || post.takenAtTimestamp || '';\n  if (publishedAt) {\n    const postDate = typeof publishedAt === 'number' ? new Date(publishedAt * 1000).toISOString() : String(publishedAt);\n    if (postDate < currentYearStart) continue;\n  }\n\n  const username = (post.ownerUsername || post.username || '').toLowerCase().trim();\n  const src = sourceMap[username] || {};\n  const postId = String(post.id || post.shortCode || '');\n  if (!postId) continue;\n\n  const viewCount = parseNum(post.videoPlayCount || post.videoViewCount || post.playsCount || 0);\n  const likeCount = parseNum(post.likesCount || post.likes || 0);\n  const commentCount = parseNum(post.commentsCount || post.comments || 0);\n  const duration = parseInt(post.videoDuration || post.duration || 0);\n  const caption = post.caption || post.text || post.description || '';\n  const shortCode = post.shortCode || post.id || '';\n  const url = post.url || ('https://www.instagram.com/reel/' + shortCode + '/');\n  let tags = '';\n  const hashtagMatches = caption.match(/#[\\w\\u0080-\\uFFFF]+/g);\n  if (hashtagMatches) tags = hashtagMatches.map(h => h.replace(/^#/, '')).join(', ');\n\n  results.push({ cfg, video_id: postId, source_id: src.source_id || '', source_name: src.source_name || username, handle: src.handle || ('@' + username), title: caption.substring(0, 500), description: caption.substring(0, 500), tags, url, view_count: viewCount, like_count: likeCount, comment_count: commentCount, duration, published_at: publishedAt, channel_id: username, content_type: 'Reel', platform: 'Instagram' });\n}\n\nif (!results.length) { return [{ json: { _skip: true, cfg } }]; }\n\n// Per-creator baseline median over last 30 videos. Node 5 runs UPSTREAM of this node.\nconst historyByChannel = {};\nlet existingRecs = [];\ntry { existingRecs = $('5. Get All Existing Video IDs').all(); } catch (e) {}\nfor (const rec of existingRecs) {\n  const ch = (rec.json['Channel ID'] || '').toLowerCase().trim();\n  if (!ch) continue;\n  if (!historyByChannel[ch]) historyByChannel[ch] = [];\n  historyByChannel[ch].push({ v: parseInt(rec.json['View Count']) || 0, ts: rec.json['Published At'] || '' });\n}\n\nfunction median(arr) {\n  if (!arr.length) return 0;\n  const s = [...arr].sort((a, b) => a - b);\n  const mid = Math.floor(s.length / 2);\n  return s.length % 2 === 0 ? (s[mid - 1] + s[mid]) / 2 : s[mid];\n}\n\nconst currentByChannel = {};\nfor (const r of results) {\n  if (!currentByChannel[r.channel_id]) currentByChannel[r.channel_id] = [];\n  currentByChannel[r.channel_id].push({ v: r.view_count, ts: r.published_at });\n}\n\nconst baselineByChannel = {};\nconst allChannels = new Set([...Object.keys(historyByChannel), ...Object.keys(currentByChannel)]);\nfor (const ch of allChannels) {\n  const combined = [...(historyByChannel[ch] || []), ...(currentByChannel[ch] || [])]\n    .filter(x => x.v > 0)\n    .sort((a, b) => String(b.ts).localeCompare(String(a.ts)))\n    .slice(0, 30)\n    .map(x => x.v);\n  baselineByChannel[ch] = median(combined);\n}\n\nconsole.log('[4] Scored ' + results.length + ' posts against 30-video baseline');\nreturn results.map(r => {\n  const baseline = baselineByChannel[r.channel_id] || 0;\n  const outlierScore = baseline > 0 ? parseFloat((r.view_count / baseline).toFixed(2)) : 0;\n  return { json: { ...r, outlier_score: outlierScore, baseline_median: baseline } };\n});"
      },
