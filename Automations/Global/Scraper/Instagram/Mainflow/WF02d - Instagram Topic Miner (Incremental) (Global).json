    {
      "parameters": {
        "jsCode": "const existingItems = $('4. Get All Existing Video IDs').all();\nconst existingIds = new Set(existingItems.map(i => i.json['Video ID'] || '').filter(id => id !== ''));\nconst incomingItems = $input.all();\nconst cfg = (incomingItems[0] && incomingItems[0].json && incomingItems[0].json.cfg) || {};\nconst seenThisRun = new Set();\nconst newVideos = incomingItems.filter(item => {\n  if (item.json._skip) return false;\n  const vid = item.json.video_id;\n  if (!vid || existingIds.has(vid) || seenThisRun.has(vid)) return false;\n  seenThisRun.add(vid);\n  return true;\n});\nconsole.log('[5] Incoming: ' + incomingItems.length + ' | Existing: ' + existingIds.size + ' | New: ' + newVideos.length);\nif (newVideos.length === 0) return [{ json: { _skip: true, cfg, video_id: '', source_id: '', source_name: '', url: '' } }];\nreturn newVideos;"
      },
      "name": "5. Filter New Videos Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        -640
