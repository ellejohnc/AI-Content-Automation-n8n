    {
      "parameters": {
        "jsCode": "const srcItems = $input.all().map(i => i.json);\nconst cfg = (srcItems[0] || {}).cfg || {};\nconst sources = srcItems.filter(s => s && s.id);\nif (!sources.length) { return [{ json: { _skip: true, cfg, reason: 'No active Instagram sources' } }]; }\n\nconst sourceMap = {};\nconst directUrls = [];\nconst seenHandles = new Set();\nconst scanDates = [];\n\nfor (const s of sources) {\n  let handle = (s['Instagram_Handle'] || '').replace(/^@/, '').trim();\n  if (!handle) {\n    const url = (s['Instagram_Links'] || s['Links'] || '');\n    const match = url.match(/instagram\\.com\\/([^/?#]+)/);\n    if (match && !['p','reel','tv','explore','stories'].includes(match[1])) handle = match[1].trim();\n  }\n  if (!handle) continue;\n  const key = handle.toLowerCase();\n  if (seenHandles.has(key)) continue;\n  seenHandles.add(key);\n  directUrls.push('https://www.instagram.com/' + handle + '/');\n  const lastScanned = s['Instagram_Last_Scanned'] || '';\n  sourceMap[key] = { source_id: s.id || '', source_name: s['Source Name'] || '', handle: '@' + handle, last_scanned: lastScanned };\n  if (lastScanned) scanDates.push(lastScanned);\n}\n\nif (!directUrls.length) { return [{ json: { _skip: true, cfg, reason: 'No valid handles found' } }]; }\n\n// Apify's onlyPostsNewerThan is unreliable, so node 3 enforces a hard cutoff by published_at.\nconst GLOBAL_DEFAULT_DAYS = 8;\nlet onlyNewerThan;\nconst allScanned = scanDates.length === directUrls.length && scanDates.length > 0;\nif (allScanned) { onlyNewerThan = scanDates.sort()[0]; }\nelse { onlyNewerThan = GLOBAL_DEFAULT_DAYS + ' days'; }\n\nconsole.log('[2a] ' + directUrls.length + ' unique profiles | onlyPostsNewerThan=' + onlyNewerThan);\nreturn [{ json: { _skip: false, cfg, directUrls, source_map: sourceMap, only_newer_than: onlyNewerThan } }];"
      },
      "name": "2a. Prepare Apify Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -832,
        -480
      ],
      "id": "630b1cd7-d451-40d5-85ee-aca620de4283"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~instagram-scraper/runs?token=REDACTED_APIFY&maxItems=200",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "apifyApi",
        "sendHeaders": true,
        "headerParameters": {
