    {
      "parameters": {
        "jsCode": "// Gate 1: OS >= threshold. Tiers: Mega-Viral (>5.0), Strong Outlier (>=2.0).\nconst OUTLIER_THRESHOLD = 2.0;\nconst items = $input.all();\nconst cfg = (items[0] && items[0].json && items[0].json.cfg) || {};\nconst outliers = [];\nlet skipped = 0;\n\nfunction tierFor(score) {\n  if (score > 5.0) return 'Tier 1: Mega-Viral';\n  if (score >= OUTLIER_THRESHOLD) return 'Tier 2: Strong Outlier';\n  return null;\n}\n\nfor (const item of items) {\n  if (item.json._skip) continue;\n  const score = parseFloat(item.json.outlier_score) || 0;\n  const tier = tierFor(score);\n  if (tier) { outliers.push({ json: { ...item.json, _skip: false, is_outlier: true, outlier_threshold: OUTLIER_THRESHOLD, outlier_tier: tier } }); }\n  else { skipped++; }\n}\n\nconsole.log('[5b] Outliers: ' + outliers.length + ' | Below threshold: ' + skipped);\nif (outliers.length === 0) return [{ json: { _skip: true, cfg, video_id: '', source_id: '', source_name: '', url: '' } }];\nreturn outliers;"
      },
