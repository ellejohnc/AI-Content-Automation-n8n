    {
      "parameters": {
        "jsCode": "const sources = $('1. Get Active Instagram Sources').all().filter(s => s.json && s.json.id);\nlet cfg = {};\ntry { cfg = $('2a. Prepare Apify Input').first().json.cfg || {}; } catch (e) {}\nconst allVLRecords = $('9a. Get Video Library Counts').all();\nconst actualCountByName = {};\nfor (const rec of allVLRecords) {\n  const sn = rec.json['Source Name'] || '';\n  if (sn) actualCountByName[sn] = (actualCountByName[sn] || 0) + 1;\n}\nconst today = new Date().toISOString().split('T')[0];\nconst results = [];\nfor (const source of sources) {\n  const sourceName = source.json['Source Name'] || '';\n  results.push({ json: { cfg, source_id: source.json.id, source_name: sourceName, videos_found: actualCountByName[sourceName] || 0, last_scanned: today } });\n}\nconsole.log('[9b] Updating ' + results.length + ' sources');\nif (!results.length) return [];\nreturn results;"
