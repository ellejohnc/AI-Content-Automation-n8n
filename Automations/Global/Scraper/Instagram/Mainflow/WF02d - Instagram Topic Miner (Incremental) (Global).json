        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"directUrls\": {{ JSON.stringify($json.directUrls) }},\n  \"resultsType\": \"posts\",\n  \"resultsLimit\": 10,\n  \"onlyPostsNewerThan\": \"{{ $json.only_newer_than }}\",\n  \"skipPinnedPosts\": true,\n  \"addParentData\": false\n}",
