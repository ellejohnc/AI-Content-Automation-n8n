        "jsCode": "// Caps the Apify poll cycle. Per-client safe: measured from this client's own run start.\nconst MAX_POLL_MINUTES = 10;\nlet cfg = {};\ntry { cfg = $('2a. Prepare Apify Input').first().json.cfg || {}; } catch (e) {}\nlet startedAt = 0;\ntry { startedAt = Date.parse($('2b. Run Apify Actor').first().json.data.startedAt || '') || 0; } catch (e) {}\nif (!startedAt) startedAt = Date.now();\nconst elapsed = (Date.now() - startedAt) / 60000;\nconst timed_out = elapsed >= MAX_POLL_MINUTES;\nif (timed_out) console.log('[2e1] Apify poll timed out after ' + elapsed.toFixed(1) + ' min');\nreturn [{ json: { cfg, elapsed_minutes: Math.round(elapsed * 100) / 100, max_poll_minutes: MAX_POLL_MINUTES, timed_out } }];"
