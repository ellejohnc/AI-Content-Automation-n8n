      },
      "name": "2b. Run Apify Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -384,
        -480
      ],
      "id": "db48464c-211a-4cdb-b1b4-a518ca6bf3ca",
      "credentials": {
        "apifyApi": {
          "id": "Eq5ACNBTBaqokiL7",
          "name": "Apify account"
        }
      }
