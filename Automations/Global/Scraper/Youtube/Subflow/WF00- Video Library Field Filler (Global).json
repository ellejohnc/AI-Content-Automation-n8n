        400,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const CHUNK = 50;\nconst all = $('1b. Attach Config').all().map(i => i.json).filter(r => r && r.id && r['Video ID']);\nconst cfg = ($('1b. Attach Config').first().json || {}).cfg || {};\nif (!all.length) { return [{ json: { has_work: false, cfg } }]; }\nconst out = [];\nfor (let i = 0; i < all.length; i += CHUNK) {\n  const slice = all.slice(i, i + CHUNK);\n  out.push({ json: { has_work: true, cfg, chunk_index: out.length, id_csv: slice.map(r => r['Video ID']).join(','), records: slice } });\n}\nreturn out;"
      },
