      "name": "1. Get All New Videos",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        1536,
        2096
      ],
      "id": "f2606928-a07c-47f2-af0d-1cdb1e8e9821",
      "alwaysOutputData": true,
