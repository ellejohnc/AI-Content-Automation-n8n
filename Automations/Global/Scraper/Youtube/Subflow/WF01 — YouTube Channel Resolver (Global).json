      "id": "7085a252-ea6c-481d-a80b-3eee0f3e1440",
      "name": "1. Get Sources to Resolve",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        2576,
        -224
      ],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": {
          "id": "Zogs9vNOWILOB0or",
          "name": "Airtable Access Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const API_KEY = 'AIzaSyCiu4jOmy7kvNLMU9KAFcHhIW8ZVfB4OkQ';\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const cfg = item.json.cfg || {};\n  const rawUrl = (item.json['YouTube_Links'] || '').trim();\n  const recordId = item.json.id;\n  const fallbackName = item.json['Source Name'] || '';\n  if (!recordId || !rawUrl) continue;\n\n  const push = function (channelId, channelName, resolved, err) {\n    results.push({ json: { recordId, cfg, channelId: channelId || '', channelName: channelName || fallbackName, resolved: !!resolved, resolve_error: err || '', source_url: rawUrl } });\n  };\n\n  const cleanUrl = rawUrl.split('?')[0].replace(/\\/(shorts|videos|featured|playlists|community|about)\\/?$/, '');\n\n  if (cleanUrl.includes('/channel/')) {\n    const id = cleanUrl.split('/channel/')[1].split('/')[0];\n    let name = fallbackName;\n    try {\n      const res = await this.helpers.httpRequest({ method: 'GET', url: 'https://www.googleapis.com/youtube/v3/channels?part=snippet&id=' + encodeURIComponent(id) + '&key=' + API_KEY, json: true });\n      name = (res.items && res.items[0] && res.items[0].snippet && res.items[0].snippet.title) || fallbackName;\n    } catch (e) { /* keep fallback */ }\n    push(id, name, true, '');\n    continue;\n  }\n\n  let handle = '';\n  if (cleanUrl.includes('/@')) handle = cleanUrl.split('/@')[1].split('/')[0];\n  else if (cleanUrl.includes('/c/')) handle = cleanUrl.split('/c/')[1].split('/')[0];\n  else if (cleanUrl.includes('/user/')) handle = cleanUrl.split('/user/')[1].split('/')[0];\n\n  if (!handle) { push('', '', false, 'Unrecognised YouTube URL shape: ' + rawUrl); continue; }\n\n  try {\n    const res = await this.helpers.httpRequest({ method: 'GET', url: 'https://www.googleapis.com/youtube/v3/channels?part=snippet&forHandle=' + encodeURIComponent('@' + handle) + '&key=' + API_KEY, json: true });\n    const hit = res.items && res.items[0];\n    if (hit && hit.id) { push(hit.id, (hit.snippet && hit.snippet.title) || fallbackName, true, ''); continue; }\n  } catch (e) { /* fall through to scrape */ }\n\n  try {\n    const html = await this.helpers.httpRequest({ method: 'GET', url: 'https://www.youtube.com/@' + handle, headers: { 'User-Agent': 'Mozilla/5.0 (compatible; n8n-bot/1.0)' }, returnFullResponse: false });\n    const match = String(html).match(/\\/channel\\/(UC[A-Za-z0-9_\\-]{22})/);\n    if (match) {\n      const id = match[1];\n      let name = fallbackName;\n      const t = String(html).match(/<meta property=\"og:title\" content=\"([^\"]+)\"/);\n      if (t) name = t[1];\n      push(id, name, true, '');\n      continue;\n    }\n    push('', '', false, 'Channel ID not present in page HTML for @' + handle);\n  } catch (e) {\n    push('', '', false, 'Lookup failed for @' + handle + ': ' + e.message);\n  }\n}\n\nreturn results;"
      },
