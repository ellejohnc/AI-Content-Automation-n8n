        720,
        464
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "cfb4a523-0ba7-442c-86cd-191e39aef4d3",
      "name": "0c. Client Loop",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        944,
        464
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const loop = $('0c. Client Loop');\nlet cfg = null;\ntry { cfg = loop.item.json; } catch (e) { cfg = null; }\nif (!cfg || !cfg.video_base_id) { throw new Error('Could not resolve client config for this iteration.'); }\nreturn { json: { ...$input.item.json, cfg } };"
      },
      "id": "f9cfe135-0ae5-48fe-913d-4411f14ddb6f",
      "name": "1c. Attach Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const v = $('1c. Attach Config').item.json;\nconst re = $input.item.json;\nreturn { json: {\n  cfg: v.cfg,\n  video_record_id: v.id || '',\n  url: v.URL || '',\n  platform: v.Platform || '',\n  creator_handle: v['Creator_Handle'] || v['Source Name'] || '',\n  source_ids: v.Associated_Sources || [],\n  reel_engine_id: re.id || ''\n} };"
      },
      "id": "6899a0ae-7b55-46e9-a3fd-d54d7e6a9503",
      "name": "5bb. Reel Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2288,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Airtable search emits one item per input (alwaysOutputData covers the no-match case),\n// so lookups align 1:1 with the context items from 5bb.\nconst lookups = $input.all();\nconst ctx = $('5bb. Reel Context').all();\nreturn lookups.map((l, i) => {\n  const base = (ctx[i] && ctx[i].json) ? ctx[i].json : {};\n  const found = l.json || {};\n  return { json: { ...base, vl_id: found.id || '', vl_reel_engine: found['Reel Engine'] || [], vl_source: found['Source'] || [] } };\n});"
      },
      "id": "b1dd3f39-a527-4e75-9eaa-6aa078681e66",
      "name": "6b. Merge VL Lookup",
