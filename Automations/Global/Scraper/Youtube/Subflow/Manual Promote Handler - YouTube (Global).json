    {
      "parameters": {
        "jsCode": "const clients = $input.all().map(i => i.json);\nconst out = [];\nfor (const c of clients) {\n  const name = c['Client_Name'];\n  if (!name) continue;\n  if (c['Video_Enabled'] !== true) continue;\n  if (!c['Video_Base_ID']) continue;\n  out.push({ json: { client_name: name, video_base_id: c['Video_Base_ID'] } });\n}\nreturn out;"
      },
      "id": "1dd5eb83-9d1e-44d5-ab12-ddb069e69ace",
      "name": "0b. Build Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
