    {
      "parameters": {
        "jsCode": "const sources = $input.all().map(i => i.json).filter(s => s && s.id);\nconst cfg = ($input.first().json || {}).cfg || {};\nconst currentYearStart = new Date().getFullYear() + '-01-01T00:00:00Z';\nconst out = [];\n\nfor (const s of sources) {\n  const channel_id = s['YouTube Channel ID'] || '';\n  if (!channel_id) continue;\n  const yt_link = s['YouTube_Links'] || '';\n  const lowerLink = yt_link.toLowerCase();\n  let content_filter = 'all';\n  if (lowerLink.includes('/shorts')) content_filter = 'shorts_only';\n  else if (lowerLink.includes('/videos')) content_filter = 'videos_only';\n  out.push({ json: { _skip: false, cfg, source_id: s.id, source_name: s['Source Name'] || '', channel_id, content_filter, currentYearStart, yt_link } });\n}\n\nif (!out.length) { return [{ json: { _skip: true, cfg, source_id: '', source_name: '' } }]; }\nreturn out;"
      },
