    {
      "parameters": {
        "jsCode": "const existingItems = $input.all();\nconst existingIds = new Set(existingItems.map(i => i.json['Video ID'] || '').filter(id => id !== ''));\nconst incoming = $('4. Extract Video IDs').all();\nconst cfg = (incoming[0] && incoming[0].json && incoming[0].json.cfg) || {};\n\nif (incoming.length === 1 && incoming[0].json._skip_videos) {\n  return [{ json: { _skip: true, cfg } }];\n}\n\nconst seen = new Set();\nconst newVideos = [];\nfor (const item of incoming) {\n  if (item.json._skip_videos) continue;\n  const vid = item.json.video_id;\n  if (!vid || existingIds.has(vid) || seen.has(vid)) continue;\n  seen.add(vid);\n  newVideos.push(item);\n}\n\nif (!newVideos.length) return [{ json: { _skip: true, cfg } }];\nreturn newVideos;"
      },
