        "jsCode": "const CHUNK = 50;\nconst all = $input.all().map(i => i.json).filter(v => v && v.video_id);\nif (!all.length) { return []; }\nconst out = [];\nfor (let i = 0; i < all.length; i += CHUNK) {\n  const slice = all.slice(i, i + CHUNK);\n  out.push({ json: { chunk_index: out.length, id_csv: slice.map(v => v.video_id).join(','), records: slice } });\n}\nreturn out;"
