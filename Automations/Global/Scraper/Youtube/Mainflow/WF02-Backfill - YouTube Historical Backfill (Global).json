      "name": "8. Get Video Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        16736,
        4544
      ],
      "id": "48306532-e31a-4070-b367-c7a1be5869d2"
