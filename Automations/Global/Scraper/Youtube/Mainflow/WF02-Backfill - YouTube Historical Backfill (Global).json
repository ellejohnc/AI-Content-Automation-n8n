    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst sources = $('2a. Prepare Source Input').all().map(i => i.json).filter(s => !s._skip);\nconst cfg = (sources[0] || {}).cfg || {};\nconst out = [];\n\nfor (let i = 0; i < responses.length; i++) {\n  const src = sources[i];\n  if (!src) continue;\n  const raw = responses[i].json;\n  if (!raw || raw.error || (raw.statusCode && raw.statusCode >= 400)) continue;\n  const items = raw.items || [];\n  const ids = [...new Set(items.filter(x => x.id && x.id.videoId).map(x => x.id.videoId))];\n  for (const video_id of ids) {\n    out.push({ json: { video_id, cfg, source_id: src.source_id, source_name: src.source_name, channel_id: src.channel_id, content_filter: src.content_filter } });\n  }\n}\n\nif (!out.length) { return [{ json: { _skip_videos: true, cfg } }]; }\nreturn out;"
      },
