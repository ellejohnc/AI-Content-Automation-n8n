    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst chunks = $('7b. Chunk Video IDs').all();\nconst sources = $('2a. Prepare Source Input').all().map(i => i.json).filter(s => !s._skip);\nconst cfg = (sources[0] || {}).cfg || {};\n\nconst srcByChannel = {};\nfor (const s of sources) { if (s.channel_id) srcByChannel[s.channel_id] = s; }\n\n// Flag 122 resolved 2026-08-04: the YouTube shortform bonus is removed. It existed only on\n// this workflow, so YouTube Shorts scored +0.5 over TikTok and Instagram for no principled\n// reason. All three platforms now score purely on views / 30-video channel median.\nconst currentYear = new Date().getFullYear();\nconst currentYearStart = currentYear + '-01-01';\n\nfunction tierFor(score) {\n  if (score > 5.0) return 'Tier 1: Mega-Viral';\n  if (score >= 2.0) return 'Tier 2: Strong Outlier';\n  return null;\n}\n\nconst candidates = [];\nfor (let ci = 0; ci < responses.length; ci++) {\n  const metadata = (responses[ci].json && responses[ci].json.items) || [];\n  const chunkRecs = ((chunks[ci] && chunks[ci].json && chunks[ci].json.records) || []);\n  const recByVid = {};\n  for (const r of chunkRecs) recByVid[r.video_id] = r;\n\n  for (const meta of metadata) {\n    if (!meta || !meta.id) continue;\n    const snippet = meta.snippet || {};\n    const stats = meta.statistics || {};\n    if (!snippet.publishedAt || snippet.publishedAt < currentYearStart) continue;\n\n    const rec = recByVid[meta.id] || {};\n    const chId = snippet.channelId || rec.channel_id || '';\n    const src = srcByChannel[chId] || {};\n    const content_filter = rec.content_filter || src.content_filter || 'all';\n\n    const duration = (meta.contentDetails || {}).duration || 'PT0S';\n    let seconds = 0;\n    const m = duration.match(/PT(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+)S)?/);\n    if (m) seconds = (parseInt(m[1]||0)*3600) + (parseInt(m[2]||0)*60) + parseInt(m[3]||0);\n    const isShort = content_filter === 'shorts_only' ? true : content_filter === 'videos_only' ? false : seconds <= 60;\n    const contentType = isShort ? 'Short' : 'Video';\n    const url = isShort ? 'https://www.youtube.com/shorts/' + meta.id : 'https://www.youtube.com/watch?v=' + meta.id;\n\n    candidates.push({\n      cfg,\n      video_id: meta.id, title: snippet.title || 'Untitled', url,\n      channel_id: chId, description: snippet.description || '',\n      tags: Array.isArray(snippet.tags) ? snippet.tags.join(', ') : '',\n      published_at: snippet.publishedAt || '',\n      view_count: parseInt(stats.viewCount || 0), like_count: parseInt(stats.likeCount || 0),\n      comment_count: parseInt(stats.commentCount || 0), duration: seconds,\n      content_type: contentType, platform: 'YouTube',\n      source_id: rec.source_id || src.source_id || '',\n      source_name: rec.source_name || src.source_name || ''\n    });\n  }\n}\n\nif (!candidates.length) { return [{ json: { _skip: true, cfg } }]; }\n\nfunction median(arr) {\n  if (!arr.length) return 0;\n  const s = [...arr].sort((a, b) => a - b);\n  const mid = Math.floor(s.length / 2);\n  return s.length % 2 === 0 ? (s[mid - 1] + s[mid]) / 2 : s[mid];\n}\n\nconst historyByChannel = {};\nlet _existingRecs = [];\ntry { _existingRecs = $('5. Get All Existing Video IDs').all(); } catch (e) {}\nfor (const rec of _existingRecs) {\n  const ch = (rec.json['Channel ID'] || '').trim();\n  if (!ch) continue;\n  const v = parseInt(rec.json['View Count']) || 0;\n  const ts = rec.json['Published At'] || '';\n  if (!historyByChannel[ch]) historyByChannel[ch] = [];\n  historyByChannel[ch].push({ v, ts });\n}\n\nconst currentByChannel = {};\nfor (const c of candidates) {\n  if (!currentByChannel[c.channel_id]) currentByChannel[c.channel_id] = [];\n  currentByChannel[c.channel_id].push({ v: c.view_count, ts: c.published_at });\n}\n\nconst baselineByChannel = {};\nconst allChannels = new Set([...Object.keys(historyByChannel), ...Object.keys(currentByChannel)]);\nfor (const ch of allChannels) {\n  const combined = [...(historyByChannel[ch] || []), ...(currentByChannel[ch] || [])]\n    .filter(x => x.v > 0)\n    .sort((a, b) => String(b.ts).localeCompare(String(a.ts)))\n    .slice(0, 30)\n    .map(x => x.v);\n  baselineByChannel[ch] = median(combined);\n}\n\nconst results = [];\nfor (const c of candidates) {\n  const baseline = baselineByChannel[c.channel_id] || 0;\n  const score = baseline > 0 ? parseFloat((c.view_count / baseline).toFixed(2)) : 0;\n  const tier = tierFor(score);\n  if (!tier) continue;\n  results.push({ json: { ...c, outlier_score: score, baseline_median: baseline, outlier_tier: tier } });\n}\n\nresults.sort((a, b) => b.json.outlier_score - a.json.outlier_score);\nconsole.log('[8c] Outliers: ' + results.length + '/' + candidates.length);\nreturn results.length > 0 ? results : [{ json: { _skip: true, cfg } }];"
      },
