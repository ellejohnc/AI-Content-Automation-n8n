      "name": "1. Get Active TikTok Sources",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        -8704,
        -2032
      ],
      "id": "149c39fc-8428-435f-854c-8fbe68853070",
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": {
          "id": "Zogs9vNOWILOB0or",
