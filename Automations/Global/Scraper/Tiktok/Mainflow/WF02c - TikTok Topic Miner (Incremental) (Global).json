    {
      "parameters": {
        "jsCode": "const sources = $input.all().filter(s => s.json && s.json.id);\nconst cfg = ($input.first().json || {}).cfg || {};\nif (!sources.length) { return [{ json: { _skip: true, cfg, reason: 'No backfilled active TikTok sources' } }]; }\nconst sourceMap = {};\nconst profiles = [];\nconst now = Date.now();\nconst fallback = new Date(now - 2 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];\nconst scanDates = [];\nfor (const s of sources) {\n  let raw = (s.json['TikTok_Handle'] || '').replace(/^@/, '').trim();\n  if (!raw) {\n    const url = (s.json['TikTok_Links'] || '');\n    const match = url.match(/tiktok\\.com\\/@([^/?]+)/);\n    if (match) raw = match[1].trim();\n  }\n  if (!raw) continue;\n  profiles.push('https://www.tiktok.com/@' + raw);\n  sourceMap[raw.toLowerCase()] = { source_id: s.json.id || '', source_name: s.json['Source Name'] || '', handle: '@' + raw };\n  const lastScanned = s.json['TikTok_Last_Scanned'];\n  if (lastScanned) scanDates.push(new Date(lastScanned).getTime());\n}\nif (!profiles.length) { return [{ json: { _skip: true, cfg, reason: 'No valid TikTok handles' } }]; }\nlet publishedAfter = fallback;\nif (scanDates.length > 0) {\n  const bufferedTs = Math.min(...scanDates) - (1 * 24 * 60 * 60 * 1000);\n  publishedAfter = new Date(bufferedTs).toISOString().split('T')[0];\n}\nreturn [{ json: { _skip: false, cfg, profiles, source_map: sourceMap, published_after: publishedAfter } }];"
      },
      "name": "2a. Prepare Apify Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -8480,
        -2032
      ],
      "id": "663fd4ac-bbb2-4108-820c-155c2827bb51"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/clockworks~tiktok-scraper/runs?token=REDACTED_APIFY&maxItems=400",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"profiles\": {{ JSON.stringify($json.profiles) }},\n  \"resultsPerPage\": 15,\n  \"profileSorting\": \"latest\",\n  \"publishedAfter\": \"{{ $json.published_after }}\",\n  \"shouldDownloadVideos\": false,\n  \"shouldDownloadCovers\": false,\n  \"shouldDownloadSubtitles\": false,\n  \"shouldDownloadAvatars\": false\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "name": "2b. Run Apify Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -8256,
        -2032
      ],
      "id": "fae195eb-941a-42fa-a913-c2955863421b"
    },
    {
      "parameters": {
        "jsCode": "const apifyInput = $('2a. Prepare Apify Input').first().json;\nconst cfg = apifyInput.cfg || {};\nconst sourceMap = apifyInput.source_map || {};\nconst allVideos = $('2f. Fetch Dataset').all()\n  .map(i => i.json)\n  .filter(v => v && typeof v === 'object' && !v.error && (v.id || v.video_id));\nif (!allVideos.length) { return [{ json: { _skip: true, cfg, video_id: '', source_id: '', source_name: '', url: '' } }]; }\n\nconst results = [];\nfor (const video of allVideos) {\n  const authorHandle = (video['authorMeta.name'] || (video.authorMeta && video.authorMeta.name) || '').toLowerCase().trim();\n  const sourceInfo = sourceMap[authorHandle] || { source_id: '', source_name: authorHandle, handle: '@' + authorHandle };\n  const videoId = String(video.id || video.video_id || '');\n  if (!videoId) continue;\n  const parseNum = (val) => {\n    if (val == null) return 0;\n    const s = String(val).replace(/,/g, '').trim();\n    if (s.endsWith('M')) return Math.round(parseFloat(s) * 1000000);\n    if (s.endsWith('K')) return Math.round(parseFloat(s) * 1000);\n    return parseInt(s) || 0;\n  };\n  const durationSec = parseInt(video['videoMeta.duration'] || (video.videoMeta && video.videoMeta.duration) || video.duration || 0);\n  const title = video.text || video.desc || video.description || '';\n  let tags = '';\n  if (Array.isArray(video.hashtags)) {\n    tags = video.hashtags.map(h => typeof h === 'string' ? h.replace(/^#/, '') : (h.name || h.title || '')).join(', ');\n  } else if (video.text) {\n    const found = video.text.match(/#[\\w\\u0080-\\uFFFF]+/g);\n    if (found) tags = found.map(h => h.replace(/^#/, '')).join(', ');\n  }\n  const url = video.webVideoUrl || 'https://www.tiktok.com/@' + authorHandle + '/video/' + videoId;\n  results.push({\n    cfg,\n    video_id: videoId, source_id: sourceInfo.source_id, source_name: sourceInfo.source_name,\n    handle: sourceInfo.handle, title, description: title, tags, url,\n    view_count: parseNum(video.playCount), like_count: parseNum(video.diggCount),\n    comment_count: parseNum(video.commentCount), share_count: parseNum(video.shareCount || 0),\n    duration: durationSec, published_at: video.createTimeISO || '',\n    channel_id: authorHandle, content_type: 'TikTok', platform: 'TikTok'\n  });\n}\n\nif (!results.length) { return [{ json: { _skip: true, cfg, video_id: '', source_id: '', source_name: '', url: '' } }]; }\n\nconst historyByChannel = {};\nconst existingRecs = $input.all();\nfor (const rec of existingRecs) {\n  const ch = (rec.json['Channel ID'] || '').toLowerCase().trim();\n  if (!ch) continue;\n  const v = parseInt(rec.json['View Count']) || 0;\n  const ts = rec.json['Published At'] || '';\n  if (!historyByChannel[ch]) historyByChannel[ch] = [];\n  historyByChannel[ch].push({ v, ts });\n}\n\nfunction median(arr) {\n  if (!arr.length) return 0;\n  const s = [...arr].sort((a, b) => a - b);\n  const mid = Math.floor(s.length / 2);\n  return s.length % 2 === 0 ? (s[mid - 1] + s[mid]) / 2 : s[mid];\n}\n\nconst currentByChannel = {};\nfor (const r of results) {\n  if (!currentByChannel[r.channel_id]) currentByChannel[r.channel_id] = [];\n  currentByChannel[r.channel_id].push({ v: r.view_count, ts: r.published_at });\n}\n\nconst baselineByChannel = {};\nconst allChannels = new Set([...Object.keys(historyByChannel), ...Object.keys(currentByChannel)]);\nfor (const ch of allChannels) {\n  const combined = [...(historyByChannel[ch] || []), ...(currentByChannel[ch] || [])]\n    .filter(x => x.v > 0)\n    .sort((a, b) => String(b.ts).localeCompare(String(a.ts)))\n    .slice(0, 30)\n    .map(x => x.v);\n  baselineByChannel[ch] = median(combined);\n}\n\nconst scored = [];\nfor (const r of results) {\n  const baseline = baselineByChannel[r.channel_id] || 0;\n  const outlierScore = baseline > 0 ? parseFloat((r.view_count / baseline).toFixed(2)) : 0;\n  scored.push({ json: { ...r, outlier_score: outlierScore, baseline_median: baseline } });\n}\nconsole.log('[3] Scored: ' + scored.length);\nreturn scored;"
      },
