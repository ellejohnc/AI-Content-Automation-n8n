    {
      "parameters": {
        "jsCode": "const srcItems = $('1c. Attach Config').all().map(i => i.json);\nconst cfg = (srcItems[0] || {}).cfg || {};\nconst sources = srcItems.filter(s => s && s.id);\nconst out = [];\n\nfor (const s of sources) {\n  let raw = (s['TikTok_Handle'] || '').replace(/^@/, '').trim();\n  if (!raw) {\n    const url = (s['TikTok_Links'] || '');\n    const match = url.match(/tiktok\\.com\\/@([^/?]+)/);\n    if (match) raw = match[1].trim();\n  }\n  if (!raw) continue;\n  out.push({ json: { _skip: false, cfg, source_id: s.id || '', source_name: s['Source Name'] || '', handle: '@' + raw, channel_key: raw.toLowerCase(), profiles: ['https://www.tiktok.com/@' + raw] } });\n}\n\nif (!out.length) { return [{ json: { _skip: true, cfg, source_id: '', source_name: '' } }]; }\nconsole.log('[3a] Sources to backfill: ' + out.length);\nreturn out;"
      },
