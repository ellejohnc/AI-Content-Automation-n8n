        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"profiles\": {{ JSON.stringify($json.profiles) }},\n  \"resultsPerPage\": 100,\n  \"profileSorting\": \"latest\",\n  \"oldestPostDateUnified\": \"{{ new Date(new Date().getFullYear(), 0, 1).toISOString().split('T')[0] }}\",\n  \"shouldDownloadVideos\": false,\n  \"shouldDownloadCovers\": false,\n  \"shouldDownloadSubtitles\": false,\n  \"shouldDownloadAvatars\": false\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 600000
        }
      },
      "name": "4. Run Apify Backfill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2480,
        656
      ],
      "id": "4903169e-0e28-45d8-87ee-0ed56d025e76"
    },
    {
      "parameters": {
        "jsCode": "const sources = $('3a. Prepare Single Source Input').all().map(i => i.json).filter(s => !s._skip);\nconst cfg = (sources[0] || {}).cfg || {};\nconst sourceMap = {};\nfor (const s of sources) { if (s.channel_key) sourceMap[s.channel_key] = s; }\n\nconst currentYear = new Date().getFullYear();\nconst currentYearStart = currentYear + '-01-01';\n\nconst allVideos = $input.all().map(i => i.json).filter(v => v && typeof v === 'object' && !v.error && (v.id || v.video_id));\nif (!allVideos.length) { return [{ json: { _skip: true, cfg } }]; }\n\nconst parseNum = (val) => {\n  if (val == null) return 0;\n  const s = String(val).replace(/,/g, '').trim();\n  if (s.endsWith('M')) return Math.round(parseFloat(s) * 1000000);\n  if (s.endsWith('K')) return Math.round(parseFloat(s) * 1000);\n  return parseInt(s) || 0;\n};\n\nconst extracted = [];\nfor (const video of allVideos) {\n  const publishedAt = video.createTimeISO || '';\n  if (publishedAt && publishedAt < currentYearStart) continue;\n  const authorHandle = (video['authorMeta.name'] || (video.authorMeta && video.authorMeta.name) || '').toLowerCase().trim();\n  const src = sourceMap[authorHandle] || {};\n  const videoId = String(video.id || video.video_id || '');\n  if (!videoId) continue;\n  const durationSec = parseInt(video['videoMeta.duration'] || (video.videoMeta && video.videoMeta.duration) || video.duration || 0);\n  const title = video.text || video.desc || video.description || '';\n  let tags = '';\n  if (Array.isArray(video.hashtags)) {\n    tags = video.hashtags.map(h => typeof h === 'string' ? h.replace(/^#/, '') : (h.name || h.title || '')).join(', ');\n  } else if (video.text) {\n    const found = video.text.match(/#[\\w\\u0080-\\uFFFF]+/g);\n    if (found) tags = found.map(h => h.replace(/^#/, '')).join(', ');\n  }\n  const url = video.webVideoUrl || 'https://www.tiktok.com/@' + authorHandle + '/video/' + videoId;\n  extracted.push({ cfg, video_id: videoId, source_id: src.source_id || '', source_name: src.source_name || authorHandle, handle: src.handle || ('@' + authorHandle), title, description: title, tags, url, view_count: parseNum(video.playCount), like_count: parseNum(video.diggCount), comment_count: parseNum(video.commentCount), share_count: parseNum(video.shareCount || 0), duration: durationSec, published_at: publishedAt, channel_id: authorHandle, content_type: 'TikTok', platform: 'TikTok' });\n}\n\nif (!extracted.length) { return [{ json: { _skip: true, cfg } }]; }\n\nfunction median(arr) {\n  if (!arr.length) return 0;\n  const s = [...arr].sort((a, b) => a - b);\n  const mid = Math.floor(s.length / 2);\n  return s.length % 2 === 0 ? (s[mid - 1] + s[mid]) / 2 : s[mid];\n}\n\nconst historyByChannel = {};\nlet existingRecs = [];\ntry { existingRecs = $('2. Get All Existing Video IDs').all(); } catch (e) {}\nfor (const rec of existingRecs) {\n  const ch = (rec.json['Channel ID'] || '').toLowerCase().trim();\n  if (!ch) continue;\n  if (!historyByChannel[ch]) historyByChannel[ch] = [];\n  historyByChannel[ch].push({ v: parseInt(rec.json['View Count']) || 0, ts: rec.json['Published At'] || '' });\n}\n\nconst currentByChannel = {};\nfor (const v of extracted) {\n  if (!currentByChannel[v.channel_id]) currentByChannel[v.channel_id] = [];\n  currentByChannel[v.channel_id].push({ v: v.view_count, ts: v.published_at });\n}\n\nconst baselineByChannel = {};\nconst allChannels = new Set([...Object.keys(historyByChannel), ...Object.keys(currentByChannel)]);\nfor (const ch of allChannels) {\n  const combined = [...(historyByChannel[ch] || []), ...(currentByChannel[ch] || [])]\n    .filter(x => x.v > 0)\n    .sort((a, b) => String(b.ts).localeCompare(String(a.ts)))\n    .slice(0, 30)\n    .map(x => x.v);\n  baselineByChannel[ch] = median(combined);\n}\n\nconsole.log('[5] Scored ' + extracted.length + ' videos against 30-video baseline');\nreturn extracted.map(v => {\n  const baseline = baselineByChannel[v.channel_id] || 0;\n  const outlierScore = baseline > 0 ? parseFloat((v.view_count / baseline).toFixed(2)) : 0;\n  return { json: { ...v, outlier_score: outlierScore, baseline_median: baseline } };\n});"
      },
      "name": "5. Extract & Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
