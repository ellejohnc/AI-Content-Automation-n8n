    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/clockworks~tiktok-scraper/run-sync-get-dataset-items?format=json&clean=true&token=REDACTED_APIFY",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
