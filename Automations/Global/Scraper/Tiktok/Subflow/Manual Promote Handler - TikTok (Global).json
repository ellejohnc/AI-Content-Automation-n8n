        -3504
      ]
    },
    {
      "parameters": {
        "jsCode": "const lookups = $input.all();\nconst ctx = $('3a1. Merge RE Lookup').all();\nreturn lookups.map((l, i) => {\n  const base = (ctx[i] && ctx[i].json) ? ctx[i].json : {};\n  return { json: { ...base, vl_dupe_id: (l.json || {}).id || '' } };\n});"
      },
