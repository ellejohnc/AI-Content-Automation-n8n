    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const loop = $('0c. Client Loop');\nlet cfg = null;\ntry { cfg = loop.item.json; } catch (e) { cfg = null; }\nif (!cfg || !cfg.video_base_id) { throw new Error('Could not resolve client config for this iteration.'); }\nreturn { json: { ...$input.item.json, cfg } };"
      },
      "id": "3272bd50-ce59-4ad3-8e53-f3fb2b829bdf",
      "name": "1c. Attach Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        -3504
      ]
    },
    {
      "parameters": {
        "jsCode": "// Airtable search emits one item per input, so lookups align 1:1 with the video rows.\nconst lookups = $input.all();\nconst ctx = $('1c. Attach Config').all();\nreturn lookups.map((l, i) => {\n  const v = (ctx[i] && ctx[i].json) ? ctx[i].json : {};\n  const found = l.json || {};\n  const srcRaw = v.Associated_Sources || [];\n  return { json: {\n    cfg: v.cfg,\n    video_record_id: v.id || '',\n    title: v.Title || '',\n    url: v.URL || '',\n    content_type: v['Content Type'] || '',\n    source_name: v['Source Name'] || '',\n    creator_handle: v['Creator_Handle'] || '',\n    source_ids: Array.isArray(srcRaw) ? srcRaw.map(r => (typeof r === 'object' ? r.id : r)).filter(Boolean) : [],\n    re_dupe_id: found.id || ''\n  } };\n});"
      },
      "id": "584ad0d0-e97b-415e-b1fb-060541af4b54",
      "name": "3a1. Merge RE Lookup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
