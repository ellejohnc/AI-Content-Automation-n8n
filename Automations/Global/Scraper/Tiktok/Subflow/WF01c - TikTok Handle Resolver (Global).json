    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.video_base_id }}"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tbloAZ3EVCtVtCJrj"
        },
        "filterByFormula": "AND(OR(FIND('tiktok.com', {TikTok_Links}), FIND('tiktok.com', {TikTok_Handle})), {TikTok_Handle} = '')",
        "options": {}
      },
      "id": "dda038c2-02af-462b-8974-8cfffc9b9e01",
      "name": "1. Get Sources to Resolve",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        288,
        -128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": {
          "id": "Zogs9vNOWILOB0or",
          "name": "Airtable Access Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const cfg = item.json.cfg || {};\n  const recordId = item.json.id;\n  const raw = (item.json['TikTok_Links'] || item.json['TikTok_Handle'] || '').trim();\n  if (!recordId) continue;\n\n  let handle = '';\n  if (raw.includes('tiktok.com/@')) {\n    handle = raw.split('tiktok.com/@')[1].split('/')[0].split('?')[0].trim();\n  } else if (raw.startsWith('@')) {\n    handle = raw.replace(/^@/, '').split('/')[0].split('?')[0].trim();\n  } else if (raw.includes('tiktok.com/')) {\n    handle = raw.split('tiktok.com/')[1].replace(/^@/, '').split('/')[0].split('?')[0].trim();\n  } else if (raw && !raw.includes('/') && !raw.includes('.')) {\n    handle = raw.trim();\n  }\n\n  handle = handle.replace(/^@/, '');\n\n  if (!handle) {\n    results.push({ json: { recordId, cfg, handle: '', resolved: false, resolve_error: 'Could not derive a TikTok handle from: ' + (raw || '(empty)') } });\n    continue;\n  }\n\n  results.push({ json: { recordId, cfg, handle: '@' + handle, resolved: true, resolve_error: '' } });\n}\n\nreturn results;"
      },
      "id": "50f69087-d032-4eff-82a7-5c7057b3a81d",
