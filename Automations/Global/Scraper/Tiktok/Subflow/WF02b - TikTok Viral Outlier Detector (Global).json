        "airtableTokenApi": {
          "id": "Zogs9vNOWILOB0or",
          "name": "Airtable Access Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Reads the Outlier Score already computed and stored upstream by WF02c.\n// Document gate for TikTok: OS >= 3.0x, min 100 views.\nconst OUTLIER_THRESHOLD = 3.0;\nconst MIN_VIEWS = 100;\n\nconst rows = $input.all().map(i => i.json).filter(d => d && d.id);\nconst cfg = (($input.first() || {}).json || {}).cfg || {};\nif (!rows.length) { return [{ json: { _skip: true, cfg } }]; }\n\nconst detectCategory = (text) => {\n  const t = (text || '').toLowerCase();\n  const edu = ['how to','full course','beginner','masterclass','tutorial','guide','explained','learn ','lessons','levels of',' tips','skills','stop using',\"here's the fix\",'step by step','complete guide','from scratch','for beginners','crash course','deep dive','walkthrough','how i use','how i build','setup'];\n  for (const kw of edu) { if (t.includes(kw)) return 'Education'; }\n  const prod = ['product intro','product demo','product launch','product review','unboxing','hands on','first look'];\n  for (const kw of prod) { if (t.includes(kw)) return 'Product'; }\n  return 'News';\n};\n\nconst outliers = [];\nlet belowGate = 0;\n\nfor (const d of rows) {\n  const storedScore = parseFloat(d['Outlier Score'] || 0) || 0;\n  const vc = parseInt(d['View Count'] || 0, 10);\n  if (storedScore < OUTLIER_THRESHOLD || vc < MIN_VIEWS) { belowGate++; continue; }\n\n  const rawSources = d['Associated_Sources'] || [];\n  const sourceIds = Array.isArray(rawSources) ? rawSources.map(r => (typeof r === 'object' ? r.id : r)).filter(Boolean) : [];\n\n  outliers.push({ json: {\n    _skip: false,\n    cfg,\n    record_id: d.id,\n    video_id: d['Video ID'],\n    title: d['Title'],\n    url: d['URL'],\n    source_name: d['Source Name'] || 'unknown',\n    creator_handle: d['Creator_Handle'] || '',\n    source_ids: sourceIds,\n    platform: 'TikTok',\n    content_type: d['Content Type'],\n    view_count: vc,\n    outlier_score: storedScore,\n    category: detectCategory(d['Title'])\n  }});\n}\n\nconsole.log('[2] TikTok outliers: ' + outliers.length + ' | below gate: ' + belowGate);\nif (!outliers.length) { return [{ json: { _skip: true, cfg } }]; }\nreturn outliers.sort((a, b) => b.json.outlier_score - a.json.outlier_score);"
      },
      "name": "2. Platform-Specific Outlier Detection",
