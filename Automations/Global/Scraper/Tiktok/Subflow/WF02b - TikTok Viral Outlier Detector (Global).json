      "name": "1. Get All New Videos",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        576,
        80
      ],
      "id": "0ede3dd7-a5f0-4b0c-a412-c07403e25592",
      "alwaysOutputData": true,
