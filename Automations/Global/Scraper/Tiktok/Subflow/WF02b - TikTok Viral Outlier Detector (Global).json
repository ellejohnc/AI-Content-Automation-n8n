        },
        "filterByFormula": "AND({Status} = 'New', {Platform} = 'TikTok', NOT({Title} = ''), NOT({Content Type} = ''))",
        "options": {
          "fields": [
            "Video ID",
            "Title",
            "URL",
            "Source Name",
            "Creator_Handle",
            "Content Type",
