    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $input.item.json;\nconst transcriptData = $('4. Standardize Transcript').item.json;\n\nlet content = '';\ntry {\n  if (response && response.choices && response.choices[0] && response.choices[0].message && response.choices[0].message.content) {\n    content = response.choices[0].message.content;\n  } else {\n    console.log('[WF03] Unexpected OpenAI response structure');\n    content = 'PATTERN_ANALYSIS_FAILED';\n  }\n} catch (e) {\n  console.log('[WF03] Error parsing OpenAI response:', e.message);\n  content = 'PATTERN_ANALYSIS_FAILED';\n}\n\nconst hookMatch      = content.match(/HOOK_TYPE:\\s*(.+)/i);\nconst structureMatch = content.match(/STRUCTURE_TAG:\\s*(.+)/i);\nconst patternMatch   = content.match(/PATTERN:\\s*(.+)/i);\n\nreturn { json: {\n  cfg:              transcriptData.cfg || {},\n  record_id:        transcriptData.record_id,\n  transcript:       transcriptData.transcript,\n  creator_handle:   transcriptData.creator_handle || '',\n  hook_type:        hookMatch      ? hookMatch[1].trim().substring(0,100)      : 'Unknown',\n  structure_tag:    structureMatch ? structureMatch[1].trim().substring(0,100) : 'Unknown',\n  reusable_pattern: patternMatch   ? patternMatch[1].trim().substring(0,900)   : content.trim().substring(0,900)\n} };"
      },
