        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4.1-mini\",\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are an expert viral content analyst. Extract the viral pattern from a transcript. Always respond in this exact format with no extra text:\\n\\nHOOK_TYPE: [one short label e.g. Curiosity Gap, Bold Claim, Story Open, Question, Stat/Fact, Transformation, Controversy]\\nSTRUCTURE_TAG: [one short label e.g. Problem-Solution, List-Based, Tutorial, Story-Arc, News-React, Before-After]\\nPATTERN: [full reusable pattern e.g. Hook > Problem > 3 Examples > Insight > CTA]\" },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify(\"Analyze this transcript and extract the viral pattern.\\n\\nTRANSCRIPT:\\n\" + $json.transcript) }}\n    }\n  ],\n  \"max_tokens\": 300,\n  \"temperature\": 0.3\n}",
        "options": {}
