      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst cfg = item.cfg || {};\nconst url = item['URL'] || '';\nconst recordId = item.id || '';\nconst existingTranscript = item['Transcript'] || '';\nconst creatorHandle = item['Creator_Handle'] || '';\n\nlet platform = (item['Platform'] || '').toLowerCase();\nif (!platform) {\n  if (url.includes('tiktok.com')) platform = 'tiktok';\n  else if (url.includes('instagram.com')) platform = 'instagram';\n  else platform = 'youtube';\n}\n\nlet videoId = '';\nif (url.includes('v='))             videoId = url.split('v=')[1].split('&')[0];\nelse if (url.includes('shorts/'))   videoId = url.split('shorts/')[1].split('?')[0];\nelse if (url.includes('youtu.be/')) videoId = url.split('youtu.be/')[1].split('?')[0];\n\nreturn { json: {\n  cfg,\n  record_id:           recordId,\n  url:                 url,\n  video_id:            videoId,\n  platform:            platform,\n  creator_handle:      creatorHandle,\n  existing_transcript: existingTranscript\n} };"
      },
