        "jsonBody": "={{ (function(){ const d = $('Extract Record Data').item.json; const m = (d.cfg || {}).motion_graphics || {}; const payload = { record_id: d.record_id, topic: d.topic, topic_slug: d.topic_slug, category: d.category, video_url: d.video_url, timezone: (d.cfg || {}).timezone || 'Asia/Manila', base_id: (d.cfg || {}).video_base_id || '', table_id: 'tblSBKG2Zx2nZUPIT' }; if (m.brand) { payload.brand = m.brand; } if (m.composition_id) { payload.composition_id = m.composition_id; } if (m.quality) { payload.quality = m.quality; } if (m.width) { payload.width = m.width; } if (m.height) { payload.height = m.height; } if (m.extra_payload && typeof m.extra_payload === 'object') { Object.assign(payload, m.extra_payload); } return JSON.stringify(payload); })() }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 2400000
        }
