    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fresh = $input.item.json || {};\nconst d = $('Parse Render Response').item.json;\nconst m = (d.cfg || {}).motion_graphics || {};\nconst f = (fresh.fields && typeof fresh.fields === 'object') ? fresh.fields : fresh;\nconst freshNotes = (f && typeof f.Reel_Notes === 'string') ? f.Reel_Notes : '';\nconst sep = m.notes_separator || '==============================';\nconst TAG = m.stage_tag || 'MOTION GRAPHICS (WF07)';\nconst esc = t => t.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst re = new RegExp('\\\\n*' + esc(sep) + '\\\\n' + esc(TAG) + '[\\\\s\\\\S]*?(?=(\\\\n' + esc(sep) + '\\\\n)|$)', 'g');\nconst base = freshNotes.replace(re, '').trim();\nlet triggered = '';\nlet runtime = 'unknown';\ntry {\n  const raw = $('1z. Attach Config').first().json.started_at || '';\n  triggered = raw ? raw.substring(0, 16).replace('T', ' ') : '';\n  const s = Date.parse(raw);\n  if (s) { const secs = Math.max(0, Math.round((Date.now() - s) / 1000)); runtime = Math.floor(secs / 60) + 'm ' + (secs % 60) + 's'; }\n} catch (e) {}\nconst stamp = new Date().toISOString().substring(0, 16).replace('T', ' ');\nlet block = sep + '\\n' + TAG + '\\nTriggered: ' + triggered + '\\nUpdated: ' + stamp + '\\nRun time: ' + runtime;\nif (d.success) {\n  block += '\\nStage: Complete' + '\\nOutput: ' + (d.output_url || '') + (d.transcript_url ? '\\nTranscript: ' + d.transcript_url : '');\n} else {\n  block += '\\nStage: Error - render failed' + '\\nDetail: ' + (d.error || 'Unknown error');\n}\nreturn { json: { ...d, reel_notes_final: (base ? base + '\\n\\n' : '') + block } };"
      },
