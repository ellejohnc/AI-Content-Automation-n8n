      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const record = $input.item.json;\nconst cfg = record.cfg || {};\nconst g = cfg.bgm || {};\nconst recordId = record.id || '';\nconst topic = (record['Topic'] || 'content');\nconst musicBgm = record['Music_BGM'] || '';\nconst FOLDER = g.drive_folder_id || cfg.drive_folder_id || '';\nconst PREFIX = g.filename_prefix || 'BGM';\nconst TRANSITION_PCT = g.transition_percent || 40;\nconst CROSSFADE = g.crossfade_note || '0.5-1s crossfade at transition point';\n\nconst blocks = musicBgm.split(/\\n\\n+/).filter(b => b.trim().length > 0);\n\nconst extractBlock = (block) => {\n  const lines = block.trim().split('\\n').map(l => l.trim()).filter(l => l.length > 0);\n  // WF06c writes: \"1. News - Part 1 (120 BPM) (Part 1) starts at 0:00\"\n  // Strip the leading number, the \"(Part N)\" marker and the trailing \"starts at m:ss\",\n  // collapsing whitespace so the variant name does not end up glued together.\n  let variantLine = lines[0]\n    .replace(/^\\d+\\.\\s*/, '')\n    .replace(/\\s*\\(Part \\d+\\)\\s*/i, ' ')\n    .replace(/\\s*starts?\\s+at\\s+\\d+:\\d{1,2}\\s*$/i, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  const promptText = lines.slice(1).join(' ').trim();\n  const prompt = promptText || `Background music for ${topic}. Style: ${variantLine}. Instrumental only, no vocals.`;\n  const safeName = variantLine\n    .replace(/\\s*\\u2014\\s*/g, '_')\n    .replace(/\\s*\\|\\s*/g, '_')\n    .replace(/\\s+/g, '_')\n    .replace(/[^a-zA-Z0-9_]/g, '')\n    .replace(/_+/g, '_')\n    .replace(/^_|_$/g, '')\n    .substring(0, 50)\n    .toLowerCase();\n  return { variant: variantLine, prompt, safeName };\n};\n\nconst stopWords = g.stop_words || ['the','a','an','is','are','was','were','in','on','at','of','to','for','and','or','but','how','why','what','will','can','do','does','has','have','this','that','with','from'];\nconst topicKey = topic\n  .toLowerCase()\n  .replace(/[^a-z0-9\\s]/g, '')\n  .split(/\\s+/)\n  .filter(w => w.length > 0 && stopWords.indexOf(w) === -1)\n  .slice(0, 3)\n  .join('_') || 'general';\n\nlet track1 = { variant: 'generic_bgm_part1', prompt: g.fallback_prompt_1 ? String(g.fallback_prompt_1).split('{{topic}}').join(topic) : `Background music for a social media video about: ${topic}. Upbeat, corporate, instrumental, no vocals, part 1.`, safeName: 'generic_bgm_part1' };\nlet track2 = { variant: 'generic_bgm_part2', prompt: g.fallback_prompt_2 ? String(g.fallback_prompt_2).split('{{topic}}').join(topic) : `Background music for a social media video about: ${topic}. Upbeat, corporate, instrumental, no vocals, part 2, higher energy.`, safeName: 'generic_bgm_part2' };\n\nif (blocks.length >= 1) track1 = extractBlock(blocks[0]);\nif (blocks.length >= 2) track2 = extractBlock(blocks[1]);\n\nconst filename1 = `${PREFIX}_${track1.safeName}_${topicKey}_part1.mp3`;\nconst filename2 = `${PREFIX}_${track2.safeName}_${topicKey}_part2.mp3`;\n\nconst transitionNote = `BGM TRANSITION: Part 1 (${track1.variant}) runs from 0:00. Part 2 (${track2.variant}) starts at ${TRANSITION_PCT}% of video duration. Apply ${CROSSFADE}.`;\n\nconst driveQuery1 = \"name = '\" + filename1 + \"' and '\" + FOLDER + \"' in parents and trashed = false\";\nconst driveQuery2 = \"name = '\" + filename2 + \"' and '\" + FOLDER + \"' in parents and trashed = false\";\n\nreturn { json: {\n  cfg,\n  record_id: recordId,\n  topic,\n  topicKey,\n  prompt1: track1.prompt,\n  prompt2: track2.prompt,\n  filename1,\n  filename2,\n  variant1: track1.variant,\n  variant2: track2.variant,\n  transition_note: transitionNote,\n  music_bgm_raw: musicBgm,\n  drive_folder_id: FOLDER,\n  driveQuery1,\n  driveQuery2\n} };"
      },
