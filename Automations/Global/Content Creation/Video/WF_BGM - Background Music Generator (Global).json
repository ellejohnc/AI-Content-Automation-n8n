    {
      "parameters": {
        "jsCode": "// T-44: continue only when Production_Approval is ticked AND Script_Approval = Approved.\n// WF_BGM is field-triggered (no trigger status), so an unapproved record is noted once and then ignored.\nconst items = $input.all();\nconst cfg = (items[0] && items[0].json.cfg) || {};\nconst g = cfg.bgm || {};\nconst sep = g.notes_separator || '==============================';\nconst TAG = g.stage_tag || 'BGM (WF_BGM)';\nconst LINE = 'Not approved: skipped';\nconst esc = t => t.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst re = new RegExp(esc(sep) + '\\\\n' + esc(TAG) + '[\\\\s\\\\S]*?(?=(\\\\n' + esc(sep) + '\\\\n)|$)');\nconst isOk = j => { const sa = j.Script_Approval; const v = (sa && typeof sa === 'object') ? sa.name : sa; return j.Production_Approval === true && v === 'Approved'; };\nconst noted = j => { const m = String(j.Reel_Notes || '').match(re); return !!(m && m[0].includes(LINE)); };\nconst ok = items.filter(i => isOk(i.json));\nconst fresh = items.filter(i => !isOk(i.json) && !noted(i.json));\nif (fresh.length) return fresh.map(i => ({ json: { ...i.json, _route: 'note' } }));\nif (ok.length) return ok.map(i => ({ json: { ...i.json, _route: 'run' } }));\nreturn [{ json: { cfg, _route: 'none' } }];"
      },
