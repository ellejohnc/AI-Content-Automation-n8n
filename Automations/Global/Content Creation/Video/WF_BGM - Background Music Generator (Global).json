    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Tagged-block write: strip only this stage's block, keep every other stage's notes.\nconst fresh = $input.item.json || {};\nlet d = {};\ntry { d = $('6c. Build Track 2 URL').item.json; } catch (e) {\n  try { d = $('5d. Reuse Track 2 URL').item.json; } catch (e2) { d = {}; }\n}\nconst cfg = d.cfg || {};\nconst g = cfg.bgm || {};\n\nconst f = (fresh.fields && typeof fresh.fields === 'object') ? fresh.fields : fresh;\nconst freshNotes = (f && typeof f.Reel_Notes === 'string') ? f.Reel_Notes : '';\n\nconst sep = g.notes_separator || '==============================';\nconst STAGE_TAG = g.stage_tag || 'BGM (WF_BGM)';\nconst esc = t => t.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst blockRe = new RegExp('\\\\n*' + esc(sep) + '\\\\n' + esc(STAGE_TAG) + '[\\\\s\\\\S]*?(?=(\\\\n' + esc(sep) + '\\\\n)|$)', 'g');\nconst notesBase = freshNotes.replace(blockRe, '').trim();\n\nlet triggered = '';\nlet runtime = 'unknown';\ntry {\n  const raw = $('1z. Attach Config').first().json.started_at || '';\n  triggered = raw ? raw.substring(0, 16).replace('T', ' ') : '';\n  const s = Date.parse(raw);\n  if (s) { const secs = Math.max(0, Math.round((Date.now() - s) / 1000)); runtime = Math.floor(secs / 60) + 'm ' + (secs % 60) + 's'; }\n} catch (e) {}\n\nconst stamp = new Date().toISOString().substring(0, 16).replace('T', ' ');\nconst block = sep + '\\n' + STAGE_TAG\n  + '\\nTriggered: ' + triggered\n  + '\\nUpdated: ' + stamp\n  + '\\nRun time: ' + runtime\n  + '\\nStage: Complete'\n  + '\\nTrack 1: ' + (d.reused_1 ? 'reused from library' : 'generated')\n  + '\\nTrack 2: ' + (d.reused_2 ? 'reused from library' : 'generated')\n  + '\\n' + (d.transition_note || '');\n\nconst notesFinal = (notesBase ? notesBase + '\\n\\n' : '') + block;\n\nreturn { json: { ...d, reel_notes_final: notesFinal, run_time: runtime } };"
      },
