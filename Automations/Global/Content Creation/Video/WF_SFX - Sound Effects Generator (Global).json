      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const record = $input.item.json;\nconst cfg = record.cfg || {};\nconst s = cfg.sfx || {};\nconst recordId = record.id || '';\nconst sfxRaw = record['Sound_Effects'] || '';\n\nconst KNOWN_SOUNDS = s.known_sounds || ['digital_readout','whoosh','impact','riser','ding','air_hit','keyboard','mouse_click','double_click','notification','camera_shutter','digital_shutter'];\nconst EXT = s.file_extension || '.wav';\n\nconst lines = sfxRaw.split('\\n').filter(l => l.trim().length > 0);\nconst sounds = [];\n\nfor (const line of lines) {\n  const stripped = line.replace(/^\\d+\\.\\s*/, '').trim();\n  let soundName = '';\n  let cue = '';\n\n  const atMatch = stripped.match(/^([a-z_]+)\\s+at\\s+([\\d:]+)/i);\n  if (atMatch) {\n    soundName = atMatch[1].toLowerCase();\n    cue = atMatch[2];\n  } else {\n    soundName = (stripped.split(/[\\s|\\u2014\\-]/)[0] || '').toLowerCase().replace(/[^a-z_]/g, '');\n  }\n\n  if (!soundName || KNOWN_SOUNDS.indexOf(soundName) === -1) continue;\n  sounds.push({ soundName, cue, filename: soundName + EXT, index: sounds.length + 1 });\n}\n\nreturn { json: { cfg, record_id: recordId, sounds } };"
      },
