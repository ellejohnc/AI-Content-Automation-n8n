      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const driveResult = $input.item.json;\nconst ctx = $('4. Build Batch Drive Query').item.json;\n\nconst fileMap = {};\nfor (const f of (driveResult.files || [])) {\n  fileMap[f.name] = f.id;\n}\n\nconst urlLines = ctx.sounds.map((s, i) => {\n  const fileId = fileMap[s.filename] || '';\n  const url = fileId ? `https://drive.google.com/uc?export=download&id=${fileId}` : 'NOT_FOUND';\n  const cue = s.cue ? ` at ${s.cue}` : '';\n  return `${i + 1}. ${s.soundName}${cue}: ${url}`;\n}).join('\\n');\n\nreturn { json: { cfg: ctx.cfg, record_id: ctx.record_id, sound_effects_url: urlLines } };"
      },
