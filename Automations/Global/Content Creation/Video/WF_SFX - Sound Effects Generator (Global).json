      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\nconst cfg = data.cfg || {};\nconst s = cfg.sfx || {};\nconst folderId = s.drive_folder_id || cfg.drive_folder_id || '';\n\nconst nameConditions = data.sounds.map(x => `name = '${x.filename}'`).join(' or ');\nconst driveQuery = `(${nameConditions}) and '${folderId}' in parents and trashed = false`;\n\nreturn { json: { cfg, record_id: data.record_id, sounds: data.sounds, drive_folder_id: folderId, page_size: String(s.page_size || 20), driveQuery } };"
      },
